#!/usr/bin/env bash
# Builda o groovy-language-server (server side do pi-lsp-client) a partir do
# source e cacheia o JAR em ~/.local/share/groovy-lsp/. Re-executa quando o
# hash em ~/.GroovyLspPin mudar.
#
# Por que build do source e nao via mise:
#   - Upstream GroovyLanguageServer/groovy-language-server NAO tem GH Releases.
#   - aqua-registry nao tem entry pro projeto (precisaria de fork+PR, fora do
#     escopo do dotfiles).
#   - mise http: backend precisa de URL fixa pra um JAR pre-built (mesmo problema).
#   O groovy runtime ja vem via mise; o resto do toolchain (gradle 9.1) tambem.
#   Build local once via gradle, cacheadado no home, eh a forma mais limpa.
#
# Por que Java 21 explicito:
#   - gradle 9.1.0 (que o wrapper baixa) sobe ate Java 25.
#   - mise java = "26.0.2" quebra o gradle com "Unsupported class file major
#     version 70" durante o shadowJar. 21.0.2 ja esta no mise (installed pelo
#     core), entao o path nao precisa ser alterado quando o Java 26 subir.
#
# Fumado depois: ~/.pi/lsp-client.json (private_dot_pi/lsp-client.json.tmpl)
# aponta `java -jar ~/.local/share/groovy-lsp/groovy-language-server-all.jar`
# para `extensions: [".groovy"]`. O pi-lsp-client (declarado em dot_PiPackages)
# carrega esse server on-demand quando o pool do lsp-client-pool recebe a
# primeira chamada lsp_*() num arquivo .groovy/Pipeline.
#
# GroovyLspPin hash: {{ include "dot_GroovyLspPin" | sha256sum }}
set -euo pipefail

# Gradle wrapper ja vem no repo do upstream; nao precisamos de gradle no PATH.
# Mas exigimos um JDK no mise em path conhecido. Se algum dia mudar, atualize aqui.
JAVA_HOME="${JAVA_HOME:-$HOME/.local/share/mise/installs/java/21.0.2/Contents/Home}"
if [[ ! -x "$JAVA_HOME/bin/java" ]]; then
  echo ":: groovy-lsp: Java 21 not at $JAVA_HOME, skipping" >&2
  exit 0
fi

GROOVY_LSP_VERSION='{{ index (regexFindAll "[0-9a-f]{40}" (include "dot_GroovyLspPin") 1) 0 }}'
GROOVY_LSP_SRC="${XDG_CACHE_HOME:-$HOME/.cache}/groovy-lsp-src"
GROOVY_LSP_DEST="$HOME/.local/share/groovy-lsp"
GROOVY_LSP_JAR="$GROOVY_LSP_DEST/groovy-language-server-all.jar"

mkdir -p "$GROOVY_LSP_SRC" "$GROOVY_LSP_DEST"

# Clone shallow se ainda nao temos; depois fetch o commit pin.
if [[ ! -d "$GROOVY_LSP_SRC/.git" ]]; then
  git clone --depth 1 https://github.com/GroovyLanguageServer/groovy-language-server.git "$GROOVY_LSP_SRC"
fi

pushd "$GROOVY_LSP_SRC" >/dev/null
# Fetch do commit pin (pode ja estar shallow). ignore errors of "already up to date".
git fetch --depth 1 origin "$GROOVY_LSP_VERSION" 2>/dev/null || true
git checkout "$GROOVY_LSP_VERSION" 2>/dev/null || {
  echo ":: groovy-lsp: cannot checkout $GROOVY_LSP_VERSION" >&2
  exit 1
}

# Checagem dirty: se working tree tem diffs locais, rebuild pra refletir.
# Caso contrario, pula build se JAR ja existe com timestamp >= mtime do source.
NEED_BUILD=0
if [[ ! -f "$GROOVY_LSP_JAR" ]]; then
  NEED_BUILD=1
elif [[ -n "$(git status --porcelain)" ]]; then
  NEED_BUILD=1
elif [[ -n "$(find src build.gradle -newer "$GROOVY_LSP_JAR" 2>/dev/null)" ]]; then
  NEED_BUILD=1
fi

if [[ "$NEED_BUILD" -eq 1 ]]; then
  echo ":: building groovy-language-server @ $GROOVY_LSP_VERSION..."
  JAVA_HOME="$JAVA_HOME" \
  PATH="$JAVA_HOME/bin:$PATH" \
    ./gradlew shadowJar --no-daemon --console=plain 2>&1 | tail -20
fi

# O jar vai pro path GroovyLspJar independente do nome gerado pelo
# rootProject.name (que segue o nome do dir de clone; queremos estavel).
BUILT_JAR="$(find build/libs -maxdepth 1 -name '*-all.jar' | head -1 || true)"
if [[ -z "$BUILT_JAR" || ! -f "$BUILT_JAR" ]]; then
  echo ":: groovy-lsp: build artifact not found at build/libs/*-all.jar" >&2
  exit 1
fi

cp "$BUILT_JAR" "$GROOVY_LSP_JAR"
echo "  groovy-lsp: installed $GROOVY_LSP_JAR ($(du -h "$GROOVY_LSP_JAR" | cut -f1))"
popd >/dev/null

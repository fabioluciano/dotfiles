#!/usr/bin/env bash
# Gera ~/.ssh/allowed_signers para verificacao de assinaturas SSH do Git.

set -euo pipefail

ALLOWED_SIGNERS="$HOME/.ssh/allowed_signers"
PUBLIC_KEYS=("$HOME/.ssh/yubikey.pub"{{ if eq .chezmoi.os "darwin" }} "$HOME/.ssh/touchid.pub"{{ else if eq .chezmoi.os "linux" }} "$HOME/.ssh/linux_fingerprint.pub"{{ end }})
SIGNER_EMAIL="{{ .email }}"

mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"

signer_lines=''
for public_key in "${PUBLIC_KEYS[@]}"; do
    [[ -s "$public_key" ]] || continue
    signer_lines+="$SIGNER_EMAIL $(cat "$public_key")"$'\n'
done
if [[ -z "$signer_lines" ]]; then
    echo "AVISO: nenhuma chave publica disponivel para $ALLOWED_SIGNERS." >&2
    exit 0
fi
signer_lines="${signer_lines%$'\n'}"

if [[ -f "$ALLOWED_SIGNERS" ]] && [[ "$(cat "$ALLOWED_SIGNERS")" == "$signer_lines" ]]; then
  exit 0
fi

printf '%s\n' "$signer_lines" > "$ALLOWED_SIGNERS"
chmod 644 "$ALLOWED_SIGNERS"
echo "OK: $ALLOWED_SIGNERS atualizado."

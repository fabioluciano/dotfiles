{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "arch") -}}
#!/usr/bin/env bash
# Re-run whenever ~/.Pacmanfile changes.
# Pacmanfile hash: {{ include "dot_Pacmanfile" | sha256sum }}
set -euo pipefail

[[ -f "$HOME/.Pacmanfile" ]] || exit 0

if command -v yay >/dev/null 2>&1; then
    helper="yay"
elif command -v paru >/dev/null 2>&1; then
    helper="paru"
else
    echo ":: error: yay or paru is required; zsh-antidote is an AUR package" >&2
    echo ":: install one AUR helper before running chezmoi apply" >&2
    exit 1
fi

echo ":: $helper -S --needed (Pacmanfile changed)"
# vala-panel-appmenu é um pacote AUR dividido que, por padrão, tenta compilar
# as variantes mate-panel/vala-panel/budgie e puxa essas dependências. Para o
# Xfce, desabilite as demais variantes e compile apenas o plugin do painel,
# o registrar e o tradutor (GLib).
export _build_mate=false _build_xfce=true _build_vala=false _build_budgie=false
# Keep mise's Go environment from leaking into makepkg builds; the system Go
# and the toolchain selected by GOROOT must match.
unset GOROOT GOBIN GOTOOLCHAIN
# yay/paru do not accept a package list on stdin; read it into an array.
mapfile -t packages < <(grep -vE '^\s*(#|$)' "$HOME/.Pacmanfile")
[[ ${#packages[@]} -gt 0 ]] || exit 0

# colloid-gtk-theme: o install.sh do upstream roda `xfce4-panel -r` durante o
# build; dentro do fakeroot o painel aborta (glycin/bwrap) e derruba o makepkg.
# Se a instalação falhar, neutraliza essa chamada no source do cache e
# recompila com o makepkg antes de instalar o tarball gerado.
if ! pacman -Q colloid-gtk-theme >/dev/null 2>&1; then
    if ! $helper -S --needed --noconfirm colloid-gtk-theme; then
        colloid_gtk_dir="$HOME/.cache/$helper/colloid-gtk-theme"
        colloid_gtk_install=$(find "$colloid_gtk_dir/src" -maxdepth 2 -name install.sh -print -quit 2>/dev/null || true)
        if [[ -z "$colloid_gtk_install" ]]; then
            echo ":: error: colloid-gtk-theme falhou e o source não está em $colloid_gtk_dir" >&2
            exit 1
        fi
        sed -i 's|^\( *\)xfce4-panel -r$|\1:|' "$colloid_gtk_install"
        (cd "$colloid_gtk_dir" && makepkg -f --noextract --noconfirm)
        colloid_gtk_pkg=$(find "$colloid_gtk_dir" -maxdepth 1 -name 'colloid-gtk-theme-*.pkg.tar.zst' -print -quit 2>/dev/null || true)
        if [[ -n "$colloid_gtk_pkg" ]]; then
            sudo pacman -U --noconfirm "$colloid_gtk_pkg"
        else
            echo ":: error: colloid-gtk-theme falhou e nenhum tarball foi gerado" >&2
            exit 1
        fi
    fi
fi

# colloid-icon-theme-git pode falhar no passo de "tidying" do makepkg depois
# de gerar o tarball. Nesse caso, instala o pacote válido do cache.
if ! pacman -Q colloid-icon-theme-git >/dev/null 2>&1; then
    if ! $helper -S --needed --noconfirm colloid-icon-theme-git; then
        colloid_pkg=$(find "$HOME/.cache" -type f -name 'colloid-icon-theme-git-*.pkg.tar.zst' -print -quit 2>/dev/null || true)
        if [[ -n "$colloid_pkg" ]]; then
            sudo pacman -U --noconfirm "$colloid_pkg"
        else
            echo ":: error: colloid-icon-theme-git falhou e não há tarball no cache" >&2
            exit 1
        fi
    fi
fi

# libfprint-cs9711-rebase-git: o upstream referencia opencv4 no sigfm/meson.build,
# mas o Arch Linux atualizou para opencv 5 (opencv5.pc). Se a instalação falhar,
# ajusta para opencv5 no source do cache e recompila.
if ! pacman -Q libfprint-cs9711-rebase-git >/dev/null 2>&1; then
    if ! $helper -S --needed --noconfirm libfprint-cs9711-rebase-git; then
        cs9711_dir="$HOME/.cache/$helper/libfprint-cs9711-rebase-git"
        if [[ -d "$cs9711_dir" ]]; then
            (
                cd "$cs9711_dir"
                makepkg -o --noconfirm 2>/dev/null || true
                sigfm_meson=$(find "$cs9711_dir/src" -path '*/sigfm/meson.build' -print -quit 2>/dev/null || true)
                if [[ -n "$sigfm_meson" ]]; then
                    sed -i "s/dependency('opencv4'/dependency('opencv5'/" "$sigfm_meson"
                    makepkg -e -f --noconfirm
                    pkg=$(find "$cs9711_dir" -maxdepth 1 -name 'libfprint-cs9711-rebase-git-*.pkg.tar.zst' ! -name '*-debug-*' -print -quit 2>/dev/null || true)
                    if [[ -n "$pkg" ]]; then
                        sudo pacman -Rdd --noconfirm libfprint 2>/dev/null || true
                        sudo pacman -U --noconfirm "$pkg"
                    fi
                fi
            )
        fi
    fi
fi


$helper -S --needed --noconfirm "${packages[@]}"
{{- end -}}

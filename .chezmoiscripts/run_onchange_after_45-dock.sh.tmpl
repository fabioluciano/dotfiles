#!/usr/bin/env bash
# Configure Dock apps and separators by category. Safe to re-run.

set -euo pipefail

[[ "$(uname -s)" == "Darwin" ]] || exit 0
command -v dockutil >/dev/null 2>&1 || exit 0

# Finder is always pinned by macOS — no need to add it manually.
dock_items=(
    /System/Applications/Apps.app
    /System/Applications/System\ Settings.app
    /System/Applications/App\ Store.app
    ''
    /Applications/Safari.app
    /Applications/Firefox.app
    /Applications/Google\ Chrome.app
    ''
    /System/Applications/Mail.app
{{ if ne (includeTemplate "is-work-machine.tmpl" .) "true" }}
    /Applications/WhatsApp.app
    /Applications/Telegram.app
    /Applications/Discord.app
{{ end }}
    ''
    /System/Applications/Calendar.app
    /System/Applications/Reminders.app
    /System/Applications/Notes.app
    /Applications/Obsidian.app
    ''
    /Applications/OpenSuperWhisper.app
    ''
    /Applications/Ghostty.app
    /Applications/Visual\ Studio\ Code.app
    /Applications/Zed.app
    /Applications/DBeaver.app
    /Applications/Bruno.app
{{ if ne (includeTemplate "is-work-machine.tmpl" .) "true" }}
    /Applications/Parallels\ Desktop.app
{{ end }}
    /Applications/Davit.app
    ''
{{ if eq (includeTemplate "is-work-machine.tmpl" .) "true" }}
    /Applications/Microsoft\ Teams.app
    /Applications/ONLYOFFICE.app
{{ end }}
    ''
    /Applications/Spotify.app
{{ if ne (includeTemplate "is-work-machine.tmpl" .) "true" }}
    /Applications/NetNewsWire.app
{{ end }}
)

# Leave the current Dock intact and fail so chezmoi retries if an app is missing.
for app in "${dock_items[@]}"; do
    [[ -z "$app" ]] && continue
    if [[ ! -e "$app" ]]; then
        echo "Dock unchanged: missing app bundle $app" >&2
        exit 1
    fi
done

dockutil --remove all --no-restart
for app in "${dock_items[@]}"; do
    if [[ -z "$app" ]]; then
        dockutil --add '' --type small-spacer --section apps --no-restart
    else
        dockutil --add "$app" --no-restart
    fi
done

dockutil --add ~/Downloads --view fan --display folder --sort dateadded --no-restart
killall Dock

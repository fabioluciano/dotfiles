#!/usr/bin/env bash
# Instala/reconcilia os plugins do omp (extensoes) a partir de ~/.OmpPlugins.
# Re-executa quando o manifest muda; install é idempotente.
# Formato do manifest: um plugin por linha (mesmo formato aceito por
# `omp plugin install`). Linhas com # ou vazias sao ignoradas.
#
# Remocao de plugins nao e feita aqui (consistente com krew/brew): para
# remover um plugin, rode `omp plugin uninstall <nome>` manualmente e tire a
# linha do manifest.
# OmpMarketplaces hash: {{ include "dot_OmpMarketplaces" | sha256sum }}
# OmpPlugins hash: {{ include "dot_OmpPlugins" | sha256sum }}
set -euo pipefail

command -v omp >/dev/null 2>&1 || exit 0
[[ -f "$HOME/.OmpMarketplaces" || -f "$HOME/.OmpPlugins" ]] || exit 0

if [[ -f "$HOME/.OmpMarketplaces" ]]; then
    echo ":: omp plugin marketplace (OmpMarketplaces changed)"
    while IFS= read -r marketplace; do
        [[ -z "$marketplace" ]] && continue
        marketplace_output=$(omp plugin marketplace add "$marketplace" 2>&1) || true
        if [[ "$marketplace_output" =~ "already exists" ]]; then
            echo "  $marketplace: already exists"
        else
            echo "  $marketplace: ok"
        fi
    done < <(grep -vE '^\s*(#|$)' "$HOME/.OmpMarketplaces")
fi

[[ -f "$HOME/.OmpPlugins" ]] || exit 0

echo ":: omp plugin install (OmpPlugins changed)"
failed=0
while IFS= read -r plugin; do
    [[ -z "$plugin" ]] && continue
    install_output=$(omp plugin install "$plugin" 2>&1) && install_exit=0 || install_exit=$?
    if [[ $install_exit -ne 0 ]]; then
        if [[ "$install_output" =~ "already installed" ]]; then
            echo "  $plugin: already installed"
        else
            echo "  $plugin: FAILED (exit $install_exit)" >&2
            echo "$install_output" >&2
            failed=1
        fi
    else
        echo "  $plugin: ok"
    fi
done < <(grep -vE '^\s*(#|$)' "$HOME/.OmpPlugins")
if [[ $failed -ne 0 ]]; then
    echo ":: omp plugin install completed with errors" >&2
fi

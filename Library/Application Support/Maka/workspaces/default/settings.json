{
  "schemaVersion": 1,
  "appearance": {
    "theme": "dark",
    "palette": "tokyo-night",
    "appIcon": "sky",
    "uiFontSize": 14,
    "terminalFontSize": 12
  },
  "personalization": {
    "uiLocale": "en"
  },
  "localMemory": {
    "enabled": true
  },
  "workspaceInstructions": {
    "enabled": true
  },
  "webSearch": {
    "defaultProvider": "model"
  },
  "chatDefaults": {
    "permissionMode": "ask"
  },
  "notifications": {
    "runComplete": true
  },
  "shell": {
    "preference": "auto"
  }
}

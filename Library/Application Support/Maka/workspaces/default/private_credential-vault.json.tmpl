{{- /* Maka credential-vault.json — armazenador seguro de segredos de conexão por UUID */ -}}
{
  "schemaVersion": 1,
  "revision": 1,
  "entries": [
    {{- $entries := list }}
    {{- if or (env "OPENCODE_GO_API_KEY") (env "OPENCODE_API_KEY") }}
      {{- $entries = append $entries (printf "{\n      \"locator\": {\n        \"scope\": \"connection\",\n        \"connectionId\": \"cdd2ecc6-555b-4d3c-9e46-ed7d1805977b\",\n        \"kind\": \"api_key\"\n      },\n      \"credentialId\": \"cdd2ecc6-555b-4d3c-9e46-ed7d18059771\",\n      \"revision\": 1,\n      \"secret\": %q,\n      \"updatedAt\": 1741000000000\n    }" (env "OPENCODE_GO_API_KEY" | default (env "OPENCODE_API_KEY"))) }}
    {{- end }}
    {{- if env "DEEPSEEK_API_KEY" }}
      {{- $entries = append $entries (printf "{\n      \"locator\": {\n        \"scope\": \"connection\",\n        \"connectionId\": \"22222222-2222-4222-8222-222222222222\",\n        \"kind\": \"api_key\"\n      },\n      \"credentialId\": \"22222222-2222-4222-8222-222222222221\",\n      \"revision\": 1,\n      \"secret\": %q,\n      \"updatedAt\": 1741000000000\n    }" (env "DEEPSEEK_API_KEY")) }}
    {{- end }}
    {{- if env "MIMO_API_KEY" }}
      {{- $entries = append $entries (printf "{\n      \"locator\": {\n        \"scope\": \"connection\",\n        \"connectionId\": \"33333333-3333-4333-8333-333333333333\",\n        \"kind\": \"api_key\"\n      },\n      \"credentialId\": \"33333333-3333-4333-8333-333333333331\",\n      \"revision\": 1,\n      \"secret\": %q,\n      \"updatedAt\": 1741000000000\n    }" (env "MIMO_API_KEY")) }}
    {{- end }}
    {{- if or (env "GEMINI_API_KEY") (env "GOOGLE_API_KEY") }}
      {{- $entries = append $entries (printf "{\n      \"locator\": {\n        \"scope\": \"connection\",\n        \"connectionId\": \"44444444-4444-4444-8444-444444444444\",\n        \"kind\": \"api_key\"\n      },\n      \"credentialId\": \"44444444-4444-4444-8444-444444444441\",\n      \"revision\": 1,\n      \"secret\": %q,\n      \"updatedAt\": 1741000000000\n    }" (env "GEMINI_API_KEY" | default (env "GOOGLE_API_KEY"))) }}
    {{- end }}
    {{- if or (env "NAVYAI_API_KEY") (env "NAVY_API_KEY") }}
      {{- $entries = append $entries (printf "{\n      \"locator\": {\n        \"scope\": \"connection\",\n        \"connectionId\": \"55555555-5555-4555-8555-555555555555\",\n        \"kind\": \"api_key\"\n      },\n      \"credentialId\": \"55555555-5555-4555-8555-555555555551\",\n      \"revision\": 1,\n      \"secret\": %q,\n      \"updatedAt\": 1741000000000\n    }" (env "NAVYAI_API_KEY" | default (env "NAVY_API_KEY"))) }}
    {{- end }}
    {{- join ",\n    " $entries }}
  ]
}

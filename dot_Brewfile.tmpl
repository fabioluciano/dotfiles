# Homebrew manifest — TAPS, formulas de taps nao-core, CASKS e (em work
# machines) formulas core do homebrew-core + tap formulas resolvidas por zb.
# Em pessoais, o zb bundle cuida dessas ultimas via dot_Zerobrewfile.tmpl.
# Work machines instalam via brew bundle (gate abaixo, is-work-machine.tmpl).
# Lista compartilhada em .chezmoitemplates/core_formulae.tmpl.

# TAPS
tap "anomalyco/tap", trusted: true
tap "argoproj/tap", trusted: true
tap "bendews/tap", trusted: true
tap "buildpacks/tap", trusted: true
tap "can1357/tap", trusted: true
tap "charmbracelet/tap", trusted: true
tap "hashicorp/tap", trusted: true
tap "libkrun/krun", trusted: true
tap "xo/xo", trusted: true
tap "xwmx/taps", trusted: true

# TAP FORMULAS — nao-core (taps que o zerobrew nao resolve; ficam no brew).
# opencode e crush (zb-resolviveis) vivem em core_formulae.tmpl, que as inclui
# em dot_Zerobrewfile para pessoais e aqui em work machines.
brew "anomalyco/tap/opencode"
brew "buildpacks/tap/pack", trusted: true
brew "can1357/tap/omp", trusted: true
brew "hashicorp/tap/hcp", trusted: true
brew "hashicorp/tap/packer", trusted: true
brew "libkrun/krun/gvproxy", trusted: true
brew "libkrun/krun/krunkit", trusted: true
brew "xwmx/taps/nb", trusted: true
brew "xo/xo/usql", trusted: true

# CORE FORMULAE — gate work machines (zb bundle e no-op atras da Zscaler).
# Em pessoais, isto vem de dot_Zerobrewfile.tmpl via zb bundle.
{{- if eq (includeTemplate "is-work-machine.tmpl" .) "true" }}
{{ includeTemplate "core_formulae.tmpl" . }}
{{- end }}


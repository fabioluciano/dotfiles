{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "disabledServers": [
    "github"
  ],
  "mcpServers": {
    "serena": {
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context",
        "ide",
        "--project-from-cwd",
        "--open-web-dashboard",
        "false"
      ],
      "timeout": 60000,
      "instructions": false
    },
    "context7": {
      "command": "context7-mcp",
      "env": {
        "CONTEXT7_API_KEY": "!cat ~/.config/context7/api_key"
      },
      "timeout": 8000
    },
    "sequential-thinking": {
      "command": "mcp-server-sequential-thinking",
      "timeout": 10000
    },
    "gh_grep": {
      "type": "http",
      "url": "https://mcp.grep.app",
      "timeout": 8000
    },
    "github": {
      "command": "github-mcp-server",
      "args": [
        "stdio"
      ],
      "timeout": 15000
    }
  }
}

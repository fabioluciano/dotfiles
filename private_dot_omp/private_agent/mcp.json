{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "serena": {
      "command": "/Users/fabioluciano/.local/bin/serena",
      "args": [
        "start-mcp-server",
        "--context",
        "ide",
        "--project-from-cwd",
        "--open-web-dashboard",
        "false"
      ],
      "timeout": 60000
    },
    "context7": {
      "command": "context7-mcp",
      "timeout": 8000
    },
    "sequential-thinking": {
      "command": "mcp-server-sequential-thinking",
      "timeout": 10000
    },
    "git": {
      "command": "mcp-server-git",
      "timeout": 10000
    },
    "gh_grep": {
      "type": "http",
      "url": "https://mcp.grep.app",
      "timeout": 8000
    },
    "kubernetes": {
      "command": "kubernetes-mcp-server",
      "args": [
        "--read-only"
      ],
      "timeout": 15000
    },
    "terraform": {
      "command": "terraform-mcp-server",
      "timeout": 10000
    },
    "playwright": {
      "command": "playwright-mcp",
      "timeout": 15000
    },
    "github": {
      "command": "/Users/fabioluciano/.local/share/mise/installs/aqua-github-github-mcp-server/latest/github-mcp-server",
      "args": [
        "stdio"
      ],
      "timeout": 15000
    }
  }
}

{{- /* Configuração direta do OMP. Edite modelRoles abaixo para mudar os modelos.
     Preserva a versão do setup escrita pelo binário. */ -}}
{{- $setupVersion := output "sh" "-c" "awk '/^setupVersion:/ {print $2; exit}' \"$HOME/.omp/agent/config.yml\" 2>/dev/null || true" | trim | default "2" -}}
{{- if not (regexMatch "^[0-9]+$" $setupVersion) -}}{{- $setupVersion = "2" -}}{{- end -}}
theme:
  dark: dark-tokyo-night
  light: light-tokyo-night
computer:
  enabled: true
  display: active
  maxHeight: 2400
modelRoles:
  # --- Raciocinio: os modelos mais fortes primeiro (cadeia R).
  default: openai-codex/gpt-6.1-terra
  task: anthropic/claude-sonnet-5-5:auto
  slow: anthropic/claude-sonnet-5-5:auto
  plan: anthropic/claude-sonnet-5-5:auto
  advisor: anthropic/claude-sonnet-5-5:auto
  judge: anthropic/claude-sonnet-5-5:auto
  # --- Trabalho leve: a camada barata primeiro (cadeia C).
  smol: opencode-go/gpt-6-luna:low
  tiny: opencode-go/gpt-6-luna:low
  memory: opencode-go/gpt-6-luna:auto
  commit: opencode-go/gpt-6-luna:low
  vision: google-antigravity/gemini-3.8-flash:low
  image: google-antigravity/gemini-3.1-flash-image
  web: web/parallel
advisor:
  enabled: true
retry:
  usageAwareFallback: true
  usageReservePct: 0
  usageReservePolicy: auto
  # Desligado: com a cadeia de fallback configurada, esperar o reset da cota
  # travaria a sessao (o opencode-go esta com reset em ~16 dias).
  waitForUsageReset: false
  fallbackChains:
    # --- Cadeia R (raciocinio): os mais fortes primeiro, a escada desce ate a
    #     camada gratuita. Nenhum papel aqui aceita sobreposicao de preco.
    default:
      - "anthropic/claude-sonnet-5-5:auto"
      - "anthropic/claude-sonnet-4-6:auto"
      - "openai-codex/gpt-6.1-terra:auto"
      - "minimax-code/MiniMax-M3:auto"
      - "opencode-go/deepseek-v4-pro:auto"
      - "google-antigravity/gemini-3.8-flash:high"
      - "xiaomi-token-plan-sgp/mimo-v2.6-pro:auto"
      - "opencode-zen/gpt-6-luna:auto"
    task:
      - "anthropic/claude-sonnet-5-5:auto"
      - "anthropic/claude-sonnet-4-6:auto"
      - "openai-codex/gpt-6.1-terra:auto"
      - "minimax-code/MiniMax-M3:auto"
      - "opencode-go/deepseek-v4-pro:auto"
      - "google-antigravity/gemini-3.8-flash:high"
      - "xiaomi-token-plan-sgp/mimo-v2.6-pro:auto"
      - "opencode-zen/gpt-6-luna:auto"
    slow:
      - "anthropic/claude-sonnet-5-5:auto"
      - "anthropic/claude-sonnet-4-6:auto"
      - "openai-codex/gpt-6.1-terra:auto"
      - "minimax-code/MiniMax-M3:auto"
      - "opencode-go/deepseek-v4-pro:auto"
      - "google-antigravity/gemini-3.8-flash:high"
      - "xiaomi-token-plan-sgp/mimo-v2.6-pro:auto"
      - "opencode-zen/gpt-6-luna:auto"
    plan:
      - "anthropic/claude-sonnet-5-5:auto"
      - "anthropic/claude-sonnet-4-6:auto"
      - "openai-codex/gpt-6.1-terra:auto"
      - "minimax-code/MiniMax-M3:auto"
      - "opencode-go/deepseek-v4-pro:auto"
      - "google-antigravity/gemini-3.8-flash:high"
      - "xiaomi-token-plan-sgp/mimo-v2.6-pro:auto"
      - "opencode-zen/gpt-6-luna:auto"
    advisor:
      - "anthropic/claude-sonnet-5-5:auto"
      - "anthropic/claude-sonnet-4-6:auto"
      - "openai-codex/gpt-6.1-terra:auto"
      - "minimax-code/MiniMax-M3:auto"
      - "opencode-go/deepseek-v4-pro:auto"
      - "google-antigravity/gemini-3.8-flash:high"
      - "xiaomi-token-plan-sgp/mimo-v2.6-pro:auto"
      - "opencode-zen/gpt-6-luna:auto"
    judge:
      - "anthropic/claude-sonnet-5-5:auto"
      - "anthropic/claude-sonnet-4-6:auto"
      - "openai-codex/gpt-6.1-terra:auto"
      - "minimax-code/MiniMax-M3:auto"
      - "opencode-go/deepseek-v4-pro:auto"
      - "google-antigravity/gemini-3.8-flash:high"
      - "xiaomi-token-plan-sgp/mimo-v2.6-pro:auto"
      - "opencode-zen/gpt-6-luna:auto"
    # --- Cadeia C (trabalho leve): a camada gratuita primeiro, com os fortes
    #     no fim como ultimo recurso.
    smol:
      - "opencode-go/gpt-6-luna:auto"
      - "opencode-go/deepseek-v4.1-flash:auto"
      - "opencode-go/claude-haiku-5-5:auto"
      - "openai-codex/gpt-6-luna:auto"
      - "minimax-code/MiniMax-M3.1-Flash:auto"
      - "google-antigravity/gemini-3.8-flash:low"
      - "xiaomi-token-plan-sgp/mimo-v2.6-flash:auto"
    tiny:
      - "opencode-go/gpt-6-luna:auto"
      - "opencode-go/deepseek-v4.1-flash:auto"
      - "opencode-go/claude-haiku-5-5:auto"
      - "openai-codex/gpt-6-luna:auto"
      - "minimax-code/MiniMax-M3.1-Flash:auto"
      - "google-antigravity/gemini-3.8-flash:low"
      - "xiaomi-token-plan-sgp/mimo-v2.6-flash:auto"
    memory:
      - "opencode-go/gpt-6-luna:auto"
      - "opencode-go/deepseek-v4.1-flash:auto"
      - "opencode-go/claude-haiku-5-5:auto"
      - "openai-codex/gpt-6-luna:auto"
      - "minimax-code/MiniMax-M3.1-Flash:auto"
      - "google-antigravity/gemini-3.8-flash:low"
      - "xiaomi-token-plan-sgp/mimo-v2.6-flash:auto"
    commit:
      - "opencode-go/gpt-6-luna:auto"
      - "opencode-go/deepseek-v4.1-flash:auto"
      - "opencode-go/claude-haiku-5-5:auto"
      - "openai-codex/gpt-6-luna:auto"
      - "minimax-code/MiniMax-M3.1-Flash:auto"
      - "google-antigravity/gemini-3.8-flash:low"
      - "xiaomi-token-plan-sgp/mimo-v2.6-flash:auto"
    # --- Visao: todos os itens aceitam input de imagem (verificado no catalogo).
    vision:
      - "opencode-go/gpt-6-luna:auto"
      - "google-antigravity/gemini-3.8-flash:auto"
      - "opencode-go/claude-haiku-5-5:auto"
      - "openai-codex/gpt-6-luna:auto"
      - "minimax-code/MiniMax-M3.1-Flash:auto"
      - "google-antigravity/gemini-3.8-flash:low"
      - "xiaomi-token-plan-sgp/mimo-v2.6-flash:auto"
    image:
      - "google-antigravity/gemini-3.1-flash-image"
      - "google-antigravity/gemini-3-pro-image"
      - "openai-codex/gpt-image-2"
    web:
      - "web/duckduckgo"
      - "web/exa"
      - "web/firecrawl"
compaction:
  # Desativado: a compactação fica a cargo do Magic Context (cortexkit).
  enabled: false
  # thresholdPercent não definido → OMP usa modo automático: max(16384, 15% da janela).
  idleEnabled: true
  idleThresholdTokens: 200000
  # Experimental: notas persistentes e histórico pesquisável entre janelas.
  experimentalContextManagement: true
  handoffSaveToDisk: true
snapcompact:
  # Inclui AGENTS.md no snapshot para manter contexto de projeto após compactação.
  systemPrompt: agents-md
  # Experimental: resultados grandes como imagens; requer modelo com visão.
  toolResults: true
branchSummary:
  enabled: true
composer:
  tokenRate: true
terminal:
  showProgress: true
eval:
  autoBackground:
    enabled: true
setupVersion: {{ $setupVersion }}
symbolPreset: nerd
github:
  enabled: true
disabledProviders:
  - apple
  - commandcode
  - alibaba-token-plan
  - deepseek
  - gitlab-duo
  - gitlab-duo-agent
  - llama.cpp
  - local
  - minimax
  - zai
tools:
  approvalMode: write
  approval:
    bash: allow
    browser: allow
    eval: allow
    task: allow
    ctx_reduce: allow
bash:
  autoBackground:
    enabled: true
  allowCompoundCommands: true
  gitGuard: true
bashInterceptor:
  enabled: true
lsp:
  enabled: true
  diagnosticsOnEdit: true
  diagnosticsOnWrite: true
  formatOnWrite: true
  diagnosticsDeduplicate: true
  servers:
    marksman:
      command: ["marksman", "server"]
      extensions: [".md", ".markdown"]
    yaml-language-server:
      command: ["yaml-language-server", "--stdio"]
      extensions: [".yaml", ".yml"]
    dockerfile-language-server:
      command: ["docker-langserver", "--stdio"]
      extensions: [".dockerfile"]
    helm-ls:
      command: ["helm_ls", "serve"]
      extensions: [".yaml", ".yml"]
    tailwindcss-language-server:
      command: ["tailwindcss-language-server", "--stdio"]
      extensions: [".html", ".css", ".js", ".jsx", ".ts", ".tsx", ".vue", ".svelte"]
    vue-language-server:
      command: ["vue-language-server", "--stdio"]
      extensions: [".vue"]
    angular-language-server:
      command: ["omp-ngserver", "--stdio"]
      extensions: [".ts", ".tsx", ".html"]
    zls:
      command: ["zls"]
      extensions: [".zig", ".zon"]
    tinymist:
      command: ["tinymist", "lsp"]
      extensions: [".typ"]
    basedpyright:
      command: ["basedpyright-langserver", "--stdio"]
      extensions: [".py", ".pyi"]
    jdtls:
      command: ["jdtls"]
      extensions: [".java", ".groovy"]
    taplo:
      command: ["taplo", "lsp", "stdio"]
      extensions: [".toml"]
    sql-language-server:
      command: ["sql-language-server", "up", "--method", "stdio"]
      extensions: [".sql"]
    cmake-language-server:
      command: ["cmake-language-server"]
      extensions: ["CMakeLists.txt", ".cmake"]
    mdx-language-server:
      command: ["mdx-language-server", "--stdio"]
      extensions: [".mdx"]
    docker-compose-langserver:
      command: ["docker-compose-langserver", "--stdio"]
      extensions: ["docker-compose.yml", "docker-compose.yaml", "compose.yml", "compose.yaml"]
    terraform-ls:
      command: ["terraform-ls", "serve"]
      extensions: [".tf", ".tfvars"]
    vscode-css-language-server:
      command: ["vscode-css-language-server", "--stdio"]
      extensions: [".css", ".scss", ".less"]
    vscode-html-language-server:
      command: ["vscode-html-language-server", "--stdio"]
      extensions: [".html", ".htm"]
    vscode-json-language-server:
      command: ["vscode-json-language-server", "--stdio"]
      extensions: [".json", ".jsonc"]
    vscode-eslint-language-server:
      command: ["vscode-eslint-language-server", "--stdio"]
      extensions: [".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs"]
    biome:
      command: ["biome", "lsp-proxy"]
      extensions: [".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs", ".json", ".jsonc", ".css", ".scss"]
    oxlint:
      command: ["oxlint", "--lsp"]
      extensions: [".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs"]
    gopls:
      command: ["gopls"]
      extensions: [".go"]
    rust-analyzer:
      command: ["rust-analyzer"]
      extensions: [".rs"]
    lua-language-server:
      command: ["lua-language-server"]
      extensions: [".lua"]
    bash-language-server:
      command: ["bash-language-server", "start"]
      extensions: [".sh", ".bash", ".zsh"]
    typescript-language-server:
      command: ["typescript-language-server", "--stdio"]
      extensions: [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs"]
    elixir-ls:
      command: ["elixir-ls"]
      extensions: [".ex", ".exs"]
    intelephense:
      command: ["intelephense", "--stdio"]
      extensions: [".php"]
    ruff:
      command: ["ruff", "server"]
      extensions: [".py", ".pyi"]
task:
  maxConcurrency: 8
  maxRecursionDepth: 1
  enableLsp: true
  showResolvedModelBadge: true
  prewalk: true
  enableEffort: true
  structured: true
  isolation:
    enabled: true
memory:
  # Desativado: memória gerenciada pelo Magic Context (cortexkit).
  backend: "off"
mnemopi:
  scoping: per-project-tagged
  embeddingVariant: multilingual
  # smol: usa openai-codex/gpt-6-luna para consolidar/sintetizar memórias.
  llmMode: smol
  injectionTokenLimit: 4000
  recallLimit: 12
  recallContextTurns: 5
  polyphonicRecall: true
  proactiveLinking: true
  enhancedRecall: true
skills:
  enabled: true
  enableSkillCommands: true
  enableAgentsUser: true
  enableAgentsProject: true
  registryUrl: https://skills.omp.sh
defaultThinkingLevel: auto
statusLine:
  preset: custom
  leftSegments: [vim, model, mode, path, git, pr, status]
  rightSegments: [session_name, token_total, cost, context_pct]
  showHookStatus: false
  separator: slash
  contextLine: percentage
  sessionAccent: true
  transparent: false
spelling:
  autocorrect: false
error:
  notify: "on"
autoResume: true
startup:
  quiet: true
update:
  channel: canary
features:
  unexpectedStopDetection: none
contextPromotion:
  enabled: true
autolearn:
  enabled: true
  # Evita captura AutoLearn que o Magic Context não reconhece no Responses API.
  autoContinue: false
edit:
  mode: hashline
  streamingAbort: true
  autoRepair:
    enabled: true
readLineNumbers: true
read:
  renderMarkdown: true
  toolResultPreview: true
astGrep:
  enabled: true
security:
  enabled: true
mcp:
  notifications: true
plan:
  autosave: true
display:
  showTokenUsage: true
  showTurnTime: true
  cacheMissMarker: true
  subagentLivePreview: true
secrets:
  enabled: true
dev:
  autoqaConsent: granted
codexResets:
  autoRedeem: "yes"
providers:
  maxInFlightRequests:
    xiaomi-token-plan-sgp: 2
  openai-codex:
    codeMode: auto
prewalk:
  enabled: true
checkpoint:
  enabled: true

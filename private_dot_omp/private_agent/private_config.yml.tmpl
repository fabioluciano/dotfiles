{{- /* Configuração direta do OMP. Edite modelRoles abaixo para mudar os modelos.
     Preserva a versão do setup escrita pelo binário. */ -}}
{{- $setupVersion := output "sh" "-c" "awk '/^setupVersion:/ {print $2; exit}' \"$HOME/.omp/agent/config.yml\" 2>/dev/null || true" | trim | default "2" -}}
{{- if not (regexMatch "^[0-9]+$" $setupVersion) -}}{{- $setupVersion = "2" -}}{{- end -}}
theme:
  dark: dark-tokyo-night
  light: light-tokyo-night
computer:
  enabled: true
  display: active
  maxHeight: 2400
# --- Corte de imagem: a tool generate_image (text-to-image) fica desligada.
#     Este e o gatilho real de uso; o role `image` sozinho nao desliga nada.
generate_image:
  enabled: false
# --- Preset padrão (codex_gemini_anthropic_minimax_xiaomi): Codex nos roles de raciocínio, Gemini nos leves.
modelRoles:
  default: anthropic/claude-sonnet-5-5:auto
  task: anthropic/claude-sonnet-5-5:medium
  slow: anthropic/claude-opus-5-5:high
  plan: anthropic/claude-opus-5-5:high
  judge: anthropic/claude-opus-5-5:high
  smol: anthropic/claude-sonnet-5-5:medium
  web: web/parallel
  fable: anthropic/claude-fable-5-2:auto
  advisor: google-antigravity/gemini-3.8-flash:auto
  memory: google-antigravity/gemini-3.8-flash:auto
  vision: google-antigravity/gemini-3.8-flash:auto
  commit: google-antigravity/gemini-3.8-flash:auto
  tiny: anthropic/claude-haiku-5-5:low
advisor:
  enabled: true
  reviewMode: agent-end
retry:
  usageAwareFallback: true
  usageReservePct: 1
  usageReservePolicy: auto
  waitForUsageReset: false
  maxRetries: 3
  rateLimitWalksChain: true
  fallbackChains:
    default:
      - anthropic/claude-opus-5-5:auto
      - minimax-code/MiniMax-M3:auto
      - xiaomi-token-plan-sgp/mimo-v2.6-pro:auto
    task:
      - anthropic/claude-sonnet-5-5:high
      - minimax-code/MiniMax-M3:high
      - xiaomi-token-plan-sgp/mimo-v2.6-pro:high
    slow:
      - anthropic/claude-opus-5-5:high
      - minimax-code/MiniMax-M3:high
      - xiaomi-token-plan-sgp/mimo-v2.6-pro:high
    plan:
      - google-antigravity/gemini-3.8-flash:high
      - minimax-code/MiniMax-M3:high
      - xiaomi-token-plan-sgp/mimo-v2.6-pro:high
    advisor:
      - google-antigravity/gemini-3.8-flash:medium
      - xiaomi-token-plan-sgp/mimo-v2.6-pro:medium
    judge:
      - google-antigravity/gemini-3.8-flash:high
      - minimax-code/MiniMax-M3:medium
      - xiaomi-token-plan-sgp/mimo-v2.6-pro:high
    smol:
      - google-antigravity/gemini-3.8-flash:medium
      - minimax-code/MiniMax-M3.1-Flash:medium
      - xiaomi-token-plan-sgp/mimo-v2.6-flash:medium
    tiny:
      - google-antigravity/gemini-3.8-flash:low
      - minimax-code/MiniMax-M3.1-Flash:low
      - xiaomi-token-plan-sgp/mimo-v2.6-flash:low
    memory:
      - google-antigravity/gemini-3.8-flash:low
      - minimax-code/MiniMax-M3.1-Flash:low
      - xiaomi-token-plan-sgp/mimo-v2.6-flash:low
    commit:
      - google-antigravity/gemini-3.8-flash:low
      - minimax-code/MiniMax-M3.1-Flash:low
      - xiaomi-token-plan-sgp/mimo-v2.6-flash:low
    vision:
      - google-antigravity/gemini-3.8-flash:low
      - xiaomi-token-plan-sgp/mimo-v2.6-flash:low
    image: []
    web:
      - web/parallel
      - web/duckduckgo
      - web/exa
      - web/firecrawl
compaction:

  modelThresholds:
    "openai-codex/gpt-6.1-sol": "f250000"
    "anthropic/claude-opus-5-5": "f200000"
    "google-antigravity/claude-opus-5-5": "f200000"
    "anthropic/claude-sonnet-5-5": "f300000"          # 1M janela
    "google-antigravity/claude-sonnet-5-5": "f300000" # 1M janela
    "openai-codex/gpt-6.1-terra": "f300000"           # 500k janela
    "minimax-code/MiniMax-M3": "f300000"              # 512k janela
    "google-antigravity/gemini-3.8-flash": "f400000"  # 1M janela, modelo leve
    "xiaomi-token-plan-sgp/mimo-v2.6-pro": "f400000"  # 1M janela, modelo leve
    # Ficam no automatico: ag claude-sonnet-4-6 (250k, ~212k) e codex gpt-6-luna
    # (272k, ~231k) ja compactam abaixo dos tetos acima.
  idleEnabled: true
  # No topo da banda de trabalho: a compactacao ociosa a 200k descartaria
  # contexto que o teto do modelo ainda permitiria usar.
  idleThresholdTokens: 400000
  # Experimental: notas persistentes e histórico pesquisável entre janelas.
  experimentalContextManagement: true
  handoffSaveToDisk: true
snapcompact:
  # none = AGENTS.md segue como texto no system prompt. agents-md/all o renderizam
  # como imagem transitoria; a descricao do setting diz que isso perde prompt cache.
  systemPrompt: none
  # Experimental: resultados grandes como imagens; requer modelo com visão.
  toolResults: true
branchSummary:
  enabled: true
composer:
  tokenRate: true
terminal:
  showProgress: true
eval:
  autoBackground:
    enabled: true
setupVersion: {{ $setupVersion }}
symbolPreset: nerd
github:
  enabled: true
disabledProviders:
  - opencode-go
  - opencode-zen
  - commandcode
  - alibaba-token-plan
  - gitlab-duo
  - gitlab-duo-agent
  - llama.cpp
  - minimax
  - opencode
  - zai
tools:
  approvalMode: yolo
  approval:
    bash: allow
    browser: allow
    eval: allow
    task: allow
bash:
  autoBackground:
    enabled: true
  allowCompoundCommands: true
  gitGuard: true
bashInterceptor:
  enabled: false
lsp:
  enabled: true
  diagnosticsOnEdit: true
  diagnosticsOnWrite: true
  formatOnWrite: true
  diagnosticsDeduplicate: true
task:
  maxConcurrency: 15
  # high: teto de thinking 16384 por subagente (max = 32768).
  maxEffort: high
  maxRecursionDepth: 1
  enableLsp: true
  showResolvedModelBadge: true
  prewalk: false
  enableEffort: true
  structured: true
  # Desligado: cada "quanto falta?" em subagent custa um request extra; com 8
  # concorrentes isso soma. A preview das ferramentas continua visivel.
  completionProbe: false
  isolation:
    enabled: true
  perCallModelAllow:
    - anthropic/claude-opus-5-5
    - anthropic/claude-fable-5-2
  perCallModel: "on"
memory:
  backend: mnemopi
mnemopi:
  scoping: per-project-tagged
  embeddingVariant: multilingual
  # smol: usa o role tiny (hoje openai-codex/gpt-6-luna:low; cai no smol se
  # o tiny faltar) para consolidar/sintetizar memórias.
  llmMode: smol
  # Pinados para que mudança de default no omp não altere o comportamento.
  autoRecall: true
  autoRetain: true
  retainEveryNTurns: 4
  injectionTokenLimit: 1500
  recallLimit: 6
  recallContextTurns: 5
  polyphonicRecall: true
  proactiveLinking: true
  enhancedRecall: true
skills:
  enabled: true
  enableSkillCommands: true
  enableAgentsUser: true
  enableAgentsProject: true
  registryUrl: https://skills.omp.sh
defaultThinkingLevel: auto
statusLine:
  preset: custom
  leftSegments: [vim, model, mode, path, git, pr, status]
  rightSegments: [session_name, token_total, cost, context_pct]
  showHookStatus: false
  separator: slash
  contextLine: percentage
  sessionAccent: true
  transparent: false
spelling:
  autocorrect: false
error:
  notify: "on"
autoResume: true
startup:
  quiet: true
update:
  channel: canary
  auto: true
features:
  unexpectedStopDetection: none
contextPromotion:
  enabled: true
autolearn:
  enabled: true
  autoContinue: false
edit:
  mode: hashline
  streamingAbort: true
  autoRepair:
    enabled: true
readLineNumbers: true
read:
  renderMarkdown: true
  toolResultPreview: true
astGrep:
  enabled: true
security:
  enabled: true
mcp:
  notifications: true
plan:
  autosave: true
display:
  showTokenUsage: true
  showTurnTime: true
  cacheMissMarker: true
  subagentLivePreview: true
secrets:
  enabled: true
dev:
  autoqaConsent: granted
codexResets:
  # Desligado: o OMP nao gasta automaticamente resets de cota salvos do Codex.
  autoRedeem5h: "no"
  autoRedeemWeekly: "no"
claudeResets:
  # Desligado: resgate automatico queima reset salvo so porque a janela de 5h
  # acabou. Resgatar manualmente quando o mensal/semanal estiver baixo.
  autoRedeem5h: "no"
  autoRedeemWeekly: "no"
providers:
  # Reenvia o ultimo request (1 token de saida) pouco antes do cache expirar,
  # so quando compensa o custo. Valores validos: off | streaming | idle.
  cacheWarming: idle
  # Cache de 1h (auto = 1h so em OAuth, 5m com API key). Valores: auto | short | long | none.
  cacheRetention: long
  maxInFlightRequests:
    xiaomi-token-plan-sgp: 2
  openai-codex:
    # Desligado: nao participar do Daybreak Blue (a OpenAI pode usar conteudo
    # das sessoes elegiveis).
    daybreak: false
# Desligado: o hand-off do prewalk para @smol tirava subagentes de um modelo
# saudavel (ex.: anthropic sonnet) e os jogava na cadeia smol, que com o Codex
# esgotado descia ate o mimo mesmo com Anthropic/Antigravity ainda com cota.
prewalk:
  enabled: false
checkpoint:
  enabled: true
# Preset salvo; ativa com /preset codex_gemini_anthropic_minimax_xiaomi
modelPresets:
  codex_gemini_anthropic_minimax_xiaomi:
    modelRoles:
      default: openai-codex/gpt-6.1-terra:medium
      task: openai-codex/gpt-6.1-terra:medium
      slow: openai-codex/gpt-6.1-sol:high
      plan: openai-codex/gpt-6.1-terra:medium
      advisor: google-antigravity/gemini-3.8-flash:auto
      judge: openai-codex/gpt-6.1-terra:medium
      smol: openai-codex/gpt-6-luna:low
      memory: google-antigravity/gemini-3.8-flash:auto
      web: web/parallel
      fable: anthropic/claude-fable-5-2:auto
      vision: google-antigravity/gemini-3.8-flash:auto
      commit: google-antigravity/gemini-3.8-flash:auto
      tiny: google-antigravity/gemini-3.8-flash:auto
    defaultThinkingLevel: auto

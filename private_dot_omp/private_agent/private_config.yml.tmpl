{{- /* Configuração direta do OMP. Edite modelRoles abaixo para mudar os modelos.
     Preserva a versão do setup escrita pelo binário. */ -}}
{{- $setupVersion := output "sh" "-c" "awk '/^setupVersion:/ {print $2; exit}' \"$HOME/.omp/agent/config.yml\" 2>/dev/null || true" | trim | default "2" -}}
{{- if not (regexMatch "^[0-9]+$" $setupVersion) -}}{{- $setupVersion = "2" -}}{{- end -}}
theme:
  dark: dark-tokyo-night
  light: light-tokyo-night
computer:
  enabled: true
  display: active
  maxHeight: 2400
generate_image:
  enabled: false
modelRoles:
  default: openai-codex/gpt-6.1-terra:medium
  smol: openai-codex/gpt-6-luna:low
  slow: openai-codex/gpt-6.1-terra:high
  vision: openai-codex/gpt-6.1-terra:medium
  plan: openai-codex/gpt-6.1-terra:high
  designer: openai-codex/gpt-6.1-terra:medium
  commit: openai-codex/gpt-6-luna:low
  tiny: openai-codex/gpt-6-luna:low
  task: openai-codex/gpt-6.1-terra:medium
  advisor: openai-codex/gpt-6.1-terra:medium
  memory: openai-codex/gpt-6-luna:low
  judge: opencode-zen/jev-1.13:auto
  web: web/parallel
advisor:
  enabled: true
  reviewMode: agent-end
retry:
  usageAwareFallback: true
  usageReservePct: 0
  usageReservePolicy: auto
  waitForUsageReset: false
  maxRetries: 3
  rateLimitWalksChain: true
  fallbackChains:
    default:
      - "kiro/gpt-5-6-terra:medium"
      - "anthropic/claude-sonnet-5-5:medium"
      - "minimax-code/MiniMax-M3:medium"
      - "xiaomi-token-plan-sgp/mimo-v2.6-pro:medium"
    smol:
      - "kiro/gpt-5-6-luna:low"
      - "anthropic/claude-haiku-5-5:low"
      - "minimax-code/MiniMax-M3.1-Flash:low"
      - "xiaomi-token-plan-sgp/mimo-v2.6-flash:low"
    slow:
      - "kiro/gpt-5-6-terra:high"
      - "anthropic/claude-opus-5-5:high"
      - "minimax-code/MiniMax-M3:high"
      - "xiaomi-token-plan-sgp/mimo-v2.6-pro:high"
    vision:
      - "kiro/gpt-5-6-terra:medium"
      - "anthropic/claude-sonnet-5-5:medium"
      - "minimax-code/MiniMax-M3:medium"
      - "xiaomi-token-plan-sgp/mimo-v2.6-pro:medium"
    plan:
      - "kiro/gpt-5-6-terra:high"
      - "anthropic/claude-opus-5-5:high"
      - "minimax-code/MiniMax-M3:high"
      - "xiaomi-token-plan-sgp/mimo-v2.6-pro:high"
    designer:
      - "kiro/gpt-5-6-terra:medium"
      - "anthropic/claude-sonnet-5-5:medium"
      - "minimax-code/MiniMax-M3:medium"
      - "xiaomi-token-plan-sgp/mimo-v2.6-pro:medium"
    commit:
      - "kiro/gpt-5-6-luna:low"
      - "anthropic/claude-haiku-5-5:low"
      - "minimax-code/MiniMax-M3.1-Flash:low"
      - "xiaomi-token-plan-sgp/mimo-v2.6-flash:low"
    tiny:
      - "kiro/gpt-5-6-luna:low"
      - "anthropic/claude-haiku-5-5:low"
      - "minimax-code/MiniMax-M3.1-Flash:low"
      - "xiaomi-token-plan-sgp/mimo-v2.6-flash:low"
    task:
      - "kiro/gpt-5-6-terra:medium"
      - "anthropic/claude-sonnet-5-5:medium"
      - "minimax-code/MiniMax-M3:medium"
      - "xiaomi-token-plan-sgp/mimo-v2.6-pro:medium"
    advisor:
      - "kiro/gpt-5-6-terra:medium"
      - "anthropic/claude-haiku-5-5:medium"
      - "minimax-code/MiniMax-M3.1-Flash:medium"
      - "xiaomi-token-plan-sgp/mimo-v2.6-flash:medium"
    memory:
      - "kiro/gpt-5-6-luna:low"
      - "anthropic/claude-haiku-5-5:low"
      - "minimax-code/MiniMax-M3.1-Flash:low"
      - "xiaomi-token-plan-sgp/mimo-v2.6-flash:low"
    judge:
      - "kiro/gpt-5-6-terra:medium"
      - "openai-codex/gpt-6.1-terra:medium"
      - "minimax-code/MiniMax-M3:medium"
      - "xiaomi-token-plan-sgp/mimo-v2.6-pro:medium"
    image: []
    web:
      - "web/parallel"
      - "web/duckduckgo"
      - "web/exa"
      - "web/firecrawl"
compaction:
  modelThresholds:
    "anthropic/claude-opus-5-5": "f200000"
    "anthropic/claude-sonnet-5-5": "f300000"          # 1M janela
    "openai-codex/gpt-6.1-terra": "f300000"           # 500k janela
    "openai-codex/gpt-6.2-sol": "f300000"             # 500k janela
    "kiro/gpt-5-6-terra": "f300000"                   # 986k janela
    "kiro/gpt-5-6-sol": "f300000"                     # 986k janela
    "kiro/gpt-5-6-luna": "f300000"                    # 986k janela
    "minimax-code/MiniMax-M3": "f300000"              # 512k janela
    "xiaomi-token-plan-sgp/mimo-v2.6-pro": "f400000"  # 1M janela, modelo leve
    "minimax-code/MiniMax-M3.1-Flash": "f400000"      # 1M janela, modelo leve
    "xiaomi-token-plan-sgp/mimo-v2.6-flash": "f400000" # 1M janela, modelo leve
    "openai-codex/gpt-6-luna": "f60000"               # janela pequena (100K visto em subagente)
    "anthropic/claude-haiku-5-5": "f60000"            # 100K janela
  idleEnabled: true
  idleThresholdTokens: 400000
  experimentalContextManagement: true
  handoffSaveToDisk: true
snapcompact:
  systemPrompt: none
  toolResults: true
branchSummary:
  enabled: true
composer:
  tokenRate: true
  predictionAlternatives: true
btw:
  inject: true
terminal:
  showProgress: true
eval:
  autoBackground:
    enabled: true
setupVersion: {{ $setupVersion }}
symbolPreset: nerd
github:
  enabled: true
disabledProviders:
  - opencode-go
  - commandcode
  - alibaba-token-plan
  - gitlab-duo
  - gitlab-duo-agent
  - llama.cpp
  - minimax
  - opencode
  - zai
tools:
  approvalMode: yolo
  approval:
    bash: allow
    browser: allow
    eval: allow
    task: allow
  speculativeExecution:
    enabled: true
bash:
  autoBackground:
    enabled: true
  allowCompoundCommands: true
  gitGuard: true
bashInterceptor:
  enabled: false
lsp:
  enabled: true
  diagnosticsOnEdit: true
  diagnosticsOnWrite: true
  formatOnWrite: true
  diagnosticsDeduplicate: true
task:
  maxConcurrency: 20
  maxEffort: high
  maxRecursionDepth: 1
  enableLsp: true
  showResolvedModelBadge: true
  prewalk: false
  enableEffort: true
  structured: true
  perCallModel: "on"
  completionProbe: false
  isolation:
    enabled: true
  autoParallel: suggest
  steps: true
memory:
  backend: mnemopi
mnemopi:
  scoping: per-project-tagged
  embeddingVariant: multilingual
  llmMode: smol
  autoRecall: true
  autoRetain: true
  retainEveryNTurns: 4
  injectionTokenLimit: 1500
  recallLimit: 6
  recallContextTurns: 5
  polyphonicRecall: true
  proactiveLinking: true
  enhancedRecall: true
skills:
  enabled: true
  enableSkillCommands: true
  enableAgentsUser: true
  enableAgentsProject: true
  registryUrl: https://skills.omp.sh
defaultThinkingLevel: auto
statusLine:
  preset: custom
  leftSegments: [vim, model, mode, path, git, pr, status]
  rightSegments: [session_name, token_total, cost, context_pct]
  showHookStatus: false
  separator: slash
  contextLine: percentage
  sessionAccent: true
  transparent: false
spelling:
  autocorrect: false
error:
  notify: "on"
autoResume: true
startup:
  quiet: true
update:
  channel: canary
  auto: true
features:
  unexpectedStopDetection: none
contextPromotion:
  enabled: true
autolearn:
  enabled: true
  autoContinue: false
edit:
  mode: hashline
  streamingAbort: true
  autoRepair:
    enabled: true
readLineNumbers: true
read:
  renderMarkdown: true
  toolResultPreview: true
astGrep:
  enabled: true
security:
  enabled: true
mcp:
  notifications: true
plan:
  autosave: true
display:
  showTokenUsage: true
  showTurnTime: true
  cacheMissMarker: true
  subagentLivePreview: true
secrets:
  enabled: true
dev:
  autoqaConsent: granted
codexResets:
  autoRedeem5h: "no"
  autoRedeemWeekly: "no"
claudeResets:
  autoRedeem5h: "no"
  autoRedeemWeekly: "no"
  autoRedeemFable: "no"
providers:
  cacheWarming: idle
  cacheRetention: long
  webKeyless: true
  openaiLiveSteering: true
  {{- if eq .chezmoi.os "darwin" }}
  tinyModelDevice: mlx
  {{- end }}
  maxInFlightRequests:
    xiaomi-token-plan-sgp: 10
  openai-codex:
    daybreak: false
textVerbosity: medium
worktree:
  onExit: "Force Remove"
tui:
  renderEmbeds: true
prewalk:
  enabled: false
checkpoint:
  enabled: true
spotlight:
  experiment:
    enabled: true

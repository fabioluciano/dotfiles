{{- /* Configuração direta do OMP. Edite modelRoles abaixo para mudar os modelos.
     Preserva a versão do setup escrita pelo binário. */ -}}
{{- $setupVersion := output "sh" "-c" "awk '/^setupVersion:/ {print $2; exit}' \"$HOME/.omp/agent/config.yml\" 2>/dev/null || true" | trim | default "2" -}}
{{- if not (regexMatch "^[0-9]+$" $setupVersion) -}}{{- $setupVersion = "2" -}}{{- end -}}
theme:
  dark: dark-tokyo-night
  light: light-tokyo-night
computer:
  enabled: true
  display: active
  maxHeight: 2400
modelRoles:
  # --- Raciocinio (cadeia R): queima primeiro a cota pequena do Antigravity
  #     (claude sonnet/opus), depois Codex, depois Anthropic, MiniMax e Xiaomi.
  #     OpenCode, NVIDIA e DeepSeek ficam fora das roles por decisao do usuario.
  #     Esforco explicito por role (nada de :auto): o custo de saida do raciocinio
  #     e proporcional ao esforco, e o auto deixa o modelo decidir sozinho.
  default: google-antigravity/claude-sonnet-5-5:medium
  task: google-antigravity/claude-sonnet-5-5:medium
  slow: google-antigravity/claude-opus-5-5:high
  plan: google-antigravity/claude-sonnet-5-5:high
  advisor: openai-codex/gpt-6-luna:medium
  judge: google-antigravity/claude-sonnet-5-5:medium
  # --- Trabalho leve (cadeia C): Codex luna primeiro, depois gemini-3.8-flash,
  #     Anthropic, MiniMax e Xiaomi. Primario = primeiro item da cadeia.
  smol: openai-codex/gpt-6-luna:low
  tiny: openai-codex/gpt-6-luna:low
  memory: openai-codex/gpt-6-luna:low
  commit: openai-codex/gpt-6-luna:low
  vision: openai-codex/gpt-6-luna:low
  image: google-antigravity/gemini-3.1-flash-image
  web: web/parallel
advisor:
  enabled: true
retry:
  usageAwareFallback: true
  usageReservePct: 0
  usageReservePolicy: auto
  # Desligado: com a cadeia de fallback configurada, esperar o reset da cota
  # travaria a sessao (o reset semanal do Anthropic pode demorar dias).
  waitForUsageReset: false
  # Limita as tentativas no mesmo modelo: com cota esgotada, o OMP alterna
  # entre contas do mesmo provider (ag/claude-*-5-5 so existe em 2 contas) e
  # so anda na cadeia quando acaba o maxRetries. 3 ~= 1 min em vez de ~3 min.
  maxRetries: 3
  rateLimitWalksChain: true
  fallbackChains:
    # --- Cadeia R (raciocinio): Antigravity claude -> Codex -> ag gemini-4-argon
    #     (so 2 contas, acaba antes) -> Anthropic -> ag gemini-3.8-flash ->
    #     MiniMax -> Xiaomi. Um modelo por cota em cada
    #     role: no AG, sonnet/opus/gpt-oss dividem o balde "Claude & GPT" de cada
    #     conta (5-5 so em 2 contas, 4-6 em outras 3, por isso os dois entram);
    #     na Anthropic, sonnet e opus dividem o 5h/7d. ag/claude-* aceitam ate high.
    default:
      - "google-antigravity/claude-sonnet-5-5:medium"
      - "google-antigravity/claude-sonnet-4-6:medium"
      - "openai-codex/gpt-6.1-terra:medium"
      - "google-antigravity/gemini-4-argon:medium"
      - "anthropic/claude-sonnet-5-5:medium"
      - "google-antigravity/gemini-3.8-flash:medium"
      - "minimax-code/MiniMax-M3:high"
      - "xiaomi-token-plan-sgp/mimo-v2.6-pro:high"
    task:
      - "google-antigravity/claude-sonnet-5-5:medium"
      - "google-antigravity/claude-sonnet-4-6:medium"
      - "openai-codex/gpt-6.1-terra:medium"
      - "google-antigravity/gemini-4-argon:medium"
      - "anthropic/claude-sonnet-5-5:medium"
      - "google-antigravity/gemini-3.8-flash:medium"
      - "minimax-code/MiniMax-M3:high"
      - "xiaomi-token-plan-sgp/mimo-v2.6-pro:high"
    slow:
      - "google-antigravity/claude-opus-5-5:high"
      - "google-antigravity/claude-opus-4-6:high"
      - "openai-codex/gpt-6.1-terra:high"
      - "google-antigravity/gemini-4-argon:high"
      - "anthropic/claude-opus-5-5:high"
      - "google-antigravity/gemini-3.8-flash:medium"
      - "minimax-code/MiniMax-M3:high"
      - "xiaomi-token-plan-sgp/mimo-v2.6-pro:high"
    plan:
      - "google-antigravity/claude-sonnet-5-5:high"
      - "google-antigravity/claude-sonnet-4-6:high"
      - "openai-codex/gpt-6.1-terra:high"
      - "google-antigravity/gemini-4-argon:high"
      - "anthropic/claude-sonnet-5-5:high"
      - "google-antigravity/gemini-3.8-flash:medium"
      - "minimax-code/MiniMax-M3:high"
      - "xiaomi-token-plan-sgp/mimo-v2.6-pro:high"
    advisor:
      - "openai-codex/gpt-6-luna:medium"
      - "google-antigravity/gemini-3.8-flash:medium"
      - "anthropic/claude-haiku-5-5:medium"
      - "minimax-code/MiniMax-M3.1-Flash:medium"
      - "xiaomi-token-plan-sgp/mimo-v2.6-pro:medium"
    judge:
      - "google-antigravity/claude-sonnet-5-5:medium"
      - "google-antigravity/claude-sonnet-4-6:medium"
      - "openai-codex/gpt-6.1-terra:medium"
      - "google-antigravity/gemini-4-argon:medium"
      - "anthropic/claude-sonnet-5-5:medium"
      - "google-antigravity/gemini-3.8-flash:medium"
      - "minimax-code/MiniMax-M3:high"
      - "xiaomi-token-plan-sgp/mimo-v2.6-pro:high"
    # --- Cadeia C (leve): Codex luna -> ag gemini-3.8-flash -> Anthropic ->
    #     MiniMax -> Xiaomi. Sem gpt-oss: ele gasta o balde "Claude & GPT" do AG.
    smol:
      - "openai-codex/gpt-6-luna:low"
      - "google-antigravity/gemini-3.8-flash:low"
      - "anthropic/claude-haiku-5-5:low"
      - "minimax-code/MiniMax-M3.1-Flash:low"
      - "xiaomi-token-plan-sgp/mimo-v2.6-flash:low"
    tiny:
      - "openai-codex/gpt-6-luna:low"
      - "google-antigravity/gemini-3.8-flash:low"
      - "anthropic/claude-haiku-5-5:low"
      - "minimax-code/MiniMax-M3.1-Flash:low"
      - "xiaomi-token-plan-sgp/mimo-v2.6-flash:low"
    memory:
      - "openai-codex/gpt-6-luna:low"
      - "google-antigravity/gemini-3.8-flash:low"
      - "anthropic/claude-haiku-5-5:low"
      - "minimax-code/MiniMax-M3.1-Flash:low"
      - "xiaomi-token-plan-sgp/mimo-v2.6-flash:low"
    commit:
      - "openai-codex/gpt-6-luna:low"
      - "google-antigravity/gemini-3.8-flash:low"
      - "anthropic/claude-haiku-5-5:low"
      - "minimax-code/MiniMax-M3.1-Flash:low"
      - "xiaomi-token-plan-sgp/mimo-v2.6-flash:low"
    # --- Visao: todos os itens aceitam input de imagem (verificado no catalogo).
    vision:
      - "openai-codex/gpt-6-luna:low"
      - "google-antigravity/gemini-3.8-flash:low"
      - "anthropic/claude-haiku-5-5:low"
      - "minimax-code/MiniMax-M3.1-Flash:low"
      - "xiaomi-token-plan-sgp/mimo-v2.6-flash:low"
    image:
      - "google-antigravity/gemini-3.1-flash-image"
      - "google-antigravity/gemini-3-pro-image"
      - "openai-codex/gpt-image-2"
    web:
      - "web/parallel"
      - "web/duckduckgo"
      - "web/exa"
      - "web/firecrawl"
compaction:
  # thresholdPercent não definido → OMP usa modo automático: max(16384, 15% da janela).
  # Tetos fixos por modelo: "f<digitos>" dispara no ponto exato, sem o escalamento
  # de 85% que o modo automatico aplica a bases de janela. Proporcionais ao custo
  # de input — os modelos de 1M de janela nao podem esperar os 85% (~850k).
  modelThresholds:
    "anthropic/claude-opus-5-5": "f250000"      # 1M janela, US$ 4,00/M — o mais caro
    "anthropic/claude-sonnet-5-5": "f300000"    # 1M janela, US$ 2,00/M
    "openai-codex/gpt-6.1-terra": "f300000"     # 500k janela, US$ 1,00/M
    "google-antigravity/gemini-3.8-flash": "f400000"  # 1M janela, US$ 0,75/M
    "xiaomi-token-plan-sgp/mimo-v2.6-pro": "f400000"  # 1M janela, US$ 0,435/M
    # openai-codex/gpt-6-luna (272k) fica no default: a politica usual ja
    # compacta perto de 231k, e o teto so se aplica a janelas maiores.
  idleEnabled: true
  # No topo da banda de trabalho: a compactacao ociosa a 200k descartaria
  # contexto que o teto do modelo ainda permitiria usar.
  idleThresholdTokens: 400000
  # Experimental: notas persistentes e histórico pesquisável entre janelas.
  experimentalContextManagement: true
  handoffSaveToDisk: true
snapcompact:
  # Inclui AGENTS.md no snapshot para manter contexto de projeto após compactação.
  systemPrompt: agents-md
  # Experimental: resultados grandes como imagens; requer modelo com visão.
  toolResults: true
branchSummary:
  enabled: true
composer:
  tokenRate: true
terminal:
  showProgress: true
eval:
  autoBackground:
    enabled: true
setupVersion: {{ $setupVersion }}
symbolPreset: nerd
github:
  enabled: true
disabledProviders:
  - opencode-go
  - opencode-zen
  - commandcode
  - alibaba-token-plan
  - gitlab-duo
  - gitlab-duo-agent
  - llama.cpp
  - minimax
  - opencode
  - zai
tools:
  approvalMode: write
  approval:
    bash: allow
    browser: allow
    eval: allow
    task: allow
bash:
  autoBackground:
    enabled: true
  allowCompoundCommands: true
  gitGuard: true
bashInterceptor:
  enabled: true
lsp:
  enabled: true
  diagnosticsOnEdit: true
  diagnosticsOnWrite: true
  formatOnWrite: true
  diagnosticsDeduplicate: true
  servers:
    marksman:
      command: ["marksman", "server"]
      extensions: [".md", ".markdown"]
    yaml-language-server:
      command: ["yaml-language-server", "--stdio"]
      extensions: [".yaml", ".yml"]
    dockerfile-language-server:
      command: ["docker-langserver", "--stdio"]
      extensions: [".dockerfile"]
    helm-ls:
      command: ["helm_ls", "serve"]
      extensions: [".yaml", ".yml"]
    tailwindcss-language-server:
      command: ["tailwindcss-language-server", "--stdio"]
      extensions: [".html", ".css", ".js", ".jsx", ".ts", ".tsx", ".vue", ".svelte"]
    vue-language-server:
      command: ["vue-language-server", "--stdio"]
      extensions: [".vue"]
    angular-language-server:
      command: ["omp-ngserver", "--stdio"]
      extensions: [".ts", ".tsx", ".html"]
    zls:
      command: ["zls"]
      extensions: [".zig", ".zon"]
    tinymist:
      command: ["tinymist", "lsp"]
      extensions: [".typ"]
    basedpyright:
      command: ["basedpyright-langserver", "--stdio"]
      extensions: [".py", ".pyi"]
    jdtls:
      command: ["jdtls"]
      extensions: [".java", ".groovy"]
    taplo:
      command: ["taplo", "lsp", "stdio"]
      extensions: [".toml"]
    sql-language-server:
      command: ["sql-language-server", "up", "--method", "stdio"]
      extensions: [".sql"]
    cmake-language-server:
      command: ["cmake-language-server"]
      extensions: ["CMakeLists.txt", ".cmake"]
    mdx-language-server:
      command: ["mdx-language-server", "--stdio"]
      extensions: [".mdx"]
    docker-compose-langserver:
      command: ["docker-compose-langserver", "--stdio"]
      extensions: ["docker-compose.yml", "docker-compose.yaml", "compose.yml", "compose.yaml"]
    terraform-ls:
      command: ["terraform-ls", "serve"]
      extensions: [".tf", ".tfvars"]
    vscode-css-language-server:
      command: ["vscode-css-language-server", "--stdio"]
      extensions: [".css", ".scss", ".less"]
    vscode-html-language-server:
      command: ["vscode-html-language-server", "--stdio"]
      extensions: [".html", ".htm"]
    vscode-json-language-server:
      command: ["vscode-json-language-server", "--stdio"]
      extensions: [".json", ".jsonc"]
    vscode-eslint-language-server:
      command: ["vscode-eslint-language-server", "--stdio"]
      extensions: [".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs"]
    biome:
      command: ["biome", "lsp-proxy"]
      extensions: [".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs", ".json", ".jsonc", ".css", ".scss"]
    oxlint:
      command: ["oxlint", "--lsp"]
      extensions: [".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs"]
    gopls:
      command: ["gopls"]
      extensions: [".go"]
    rust-analyzer:
      command: ["rust-analyzer"]
      extensions: [".rs"]
    lua-language-server:
      command: ["lua-language-server"]
      extensions: [".lua"]
    bash-language-server:
      command: ["bash-language-server", "start"]
      extensions: [".sh", ".bash", ".zsh"]
    typescript-language-server:
      command: ["typescript-language-server", "--stdio"]
      extensions: [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs"]
    elixir-ls:
      command: ["elixir-ls"]
      extensions: [".ex", ".exs"]
    intelephense:
      command: ["intelephense", "--stdio"]
      extensions: [".php"]
    ruff:
      command: ["ruff", "server"]
      extensions: [".py", ".pyi"]
task:
  maxConcurrency: 8
  maxRecursionDepth: 1
  enableLsp: true
  showResolvedModelBadge: true
  prewalk: true
  enableEffort: true
  structured: true
  # Desligado: cada "quanto falta?" em subagent custa um request extra; com 8
  # concorrentes isso soma. A preview das ferramentas continua visivel.
  completionProbe: false
  isolation:
    enabled: true
worktree:
  # Inicio e fim: toda sessao nova nasce em worktree isolado e ele e removido
  # ao sair (limpos saem direto; com mudancas nao commitadas o OMP pergunta).
  onStart: create
  onExit: remove
memory:
  backend: mnemopi
mnemopi:
  scoping: per-project-tagged
  embeddingVariant: multilingual
  # smol: usa openai-codex/gpt-6-luna para consolidar/sintetizar memórias.
  llmMode: smol
  injectionTokenLimit: 4000
  recallLimit: 12
  recallContextTurns: 5
  polyphonicRecall: true
  proactiveLinking: true
  enhancedRecall: true
skills:
  enabled: true
  enableSkillCommands: true
  enableAgentsUser: true
  enableAgentsProject: true
  registryUrl: https://skills.omp.sh
defaultThinkingLevel: auto
statusLine:
  preset: custom
  leftSegments: [vim, model, mode, path, git, pr, status]
  rightSegments: [session_name, token_total, cost, context_pct]
  showHookStatus: false
  separator: slash
  contextLine: percentage
  sessionAccent: true
  transparent: false
spelling:
  autocorrect: false
error:
  notify: "on"
autoResume: true
startup:
  quiet: true
update:
  channel: canary
features:
  unexpectedStopDetection: none
contextPromotion:
  enabled: true
autolearn:
  enabled: true
  autoContinue: true
edit:
  mode: hashline
  streamingAbort: true
  autoRepair:
    enabled: true
readLineNumbers: true
read:
  renderMarkdown: true
  toolResultPreview: true
astGrep:
  enabled: true
security:
  enabled: true
mcp:
  notifications: true
plan:
  autosave: true
display:
  showTokenUsage: true
  showTurnTime: true
  cacheMissMarker: true
  subagentLivePreview: true
secrets:
  enabled: true
dev:
  autoqaConsent: granted
codexResets:
  # Desligado: o OMP nao gasta automaticamente resets de cota salvos do Codex.
  autoRedeem: "no"
claudeResets:
  # Desligado: resgate automatico queima reset salvo so porque a janela de 5h
  # acabou. Resgatar manualmente quando o mensal/semanal estiver baixo.
  autoRedeem: "no"
providers:
  # Aquecimento de prompt-cache no provider: auto respeita TTL e custo de cada um.
  cacheWarming: "auto"
  maxInFlightRequests:
    xiaomi-token-plan-sgp: 2
  openai-codex:
    codeMode: auto
    # Desligado: nao participar do Daybreak Blue (a OpenAI pode usar conteudo
    # das sessoes elegiveis).
    daybreak: false
prewalk:
  enabled: true
checkpoint:
  enabled: true

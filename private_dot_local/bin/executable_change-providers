#!/usr/bin/env bash
# change-providers — troca provider/tier nos agentes de coding (opencode,
# omp, pi, codewhale, maka, crush). Único executável; subcomando positional opcional
# seleciona agente.
#
# Uso:
#   change-providers <provider> [tier]          # troca em TODOS os agentes
#   change-providers opencode <provider> [tier] # só opencode
#   change-providers omp <provider> [tier]      # só omp
#   change-providers pi <provider> [tier]       # só pi
#   change-providers codewhale <provider> [tier]# só codewhale
#   change-providers maka <provider> [tier]     # só maka
#   change-providers crush <provider> [tier]    # só crush
#   change-providers status                     # estado de cada agente
#   change-providers reset                      # reset de todos
#   change-providers dry-run <provider> [tier]  # mostra sem aplicar
#   change-providers dry-run opencode <provider># dry-run de um agente
#
# Tiers: recommended (flagship), optimized (balanceado), super (econômico), ultra (fast/mínimo), free (gratuito).
set -euo pipefail

PROFILES=(optimized recommended super ultra free)
DEFAULT_PROFILE="optimized"

if [[ "$(uname -s)" == "Darwin" ]]; then
  MAKA_WORKSPACE="${HOME}/Library/Application Support/Maka/workspaces/default"
else
  MAKA_WORKSPACE="${XDG_CONFIG_HOME:-${HOME}/.config}/Maka/workspaces/default"
fi

# Agent metadata: state_file, target_files (space-separated), jq namespace.
declare -A AGENT_STATE=(
  [opencode]="${HOME}/.config/opencode/.active_provider"
  [omp]="${HOME}/.config/omp/.active_provider"
  [pi]="${HOME}/.config/pi/.active_provider"
  [codewhale]="${HOME}/.codewhale/.active_provider"
  [maka]="${HOME}/.maka/.active_provider"
  [crush]="${HOME}/.config/crush/.active_provider"
)
declare -A AGENT_NAMESPACE=(
  [opencode]="opencode.models"
  [omp]="omp.providers"
  [pi]="pi.providers"
  [codewhale]="codewhale.models"
  [maka]="maka.models"
  [crush]="crush.models"
)
declare -A AGENT_DEFAULT_TOML_KEY=(
  [opencode]="opencode.default_provider"
  [omp]="omp.default_provider"
  [pi]="pi.default_provider"
  [codewhale]="codewhale.default_provider"
  [maka]="maka.default_provider"
  [crush]="crush.default_provider"
)
declare -A AGENT_TARGETS=(
  [opencode]="${HOME}/.config/opencode/opencode.jsonc|${HOME}/.config/opencode/omo.jsonc|${HOME}/.config/opencode/omo-slim.jsonc|${HOME}/.config/opencode/oh-my-opencode-slim.json|${HOME}/.config/cortexkit/magic-context.jsonc"
  [omp]="${HOME}/.omp/agent/config.yml|${HOME}/.omp/agent/models.yml"
  [pi]="${HOME}/.pi/agent/settings.json|${HOME}/.pi/agent/models.json"
  [codewhale]="${HOME}/.codewhale/config.toml"
  [maka]="${MAKA_WORKSPACE}/connection-catalog.json|${MAKA_WORKSPACE}/credentials.json|${MAKA_WORKSPACE}/credential-vault.json|${HOME}/.maka/AGENTS.md"
  [crush]="${HOME}/.config/crush/crush.json|${HOME}/.config/crush/CRUSH.md"
)
ALL_AGENTS=(opencode omp pi codewhale maka crush)

usage() {
  cat >&2 <<EOF
Uso:
  $(basename "$0") <provider> [tier]             # todos os agentes
  $(basename "$0") <agente> <provider> [tier]    # um agente
  $(basename "$0") status
  $(basename "$0") reset
  $(basename "$0") dry-run <provider> [tier]
  $(basename "$0") dry-run <agente> <provider> [tier]

Agentes: ${ALL_AGENTS[*]}
Tiers: ${PROFILES[*]} (padrão: ${DEFAULT_PROFILE})
EOF
  exit 1
}

is_agent() { [[ " ${ALL_AGENTS[*]} " == *" $1 "* ]]; }

normalize_profile() {
  local input=${1:-$DEFAULT_PROFILE}
  case "$input" in
    default|moderate|optimized|balanced|tier2) echo "optimized"; return 0 ;;
    recommended|flagship|expensive|tier1)     echo "recommended"; return 0 ;;
    super|cheap|economic|tier3)                 echo "super"; return 0 ;;
    ultra|tier4)                                echo "ultra"; return 0 ;;
    free)                                       echo "free"; return 0 ;;
  esac
  local p
  for p in "${PROFILES[@]}"; do
    [[ "$p" == "$input" ]] && { echo "$p"; return 0; }
  done
  echo "Tier inválido: $input. Tiers válidos: ${PROFILES[*]}." >&2; exit 1
}

# load_providers <agent> → imprime lista de providers válidos (jq no providers.toml)
load_providers() {
  local agent=$1 ns=${AGENT_NAMESPACE[$1]} data providers
  data=$(chezmoi data --format=json 2>/dev/null) || true
  if [[ -n "$data" ]]; then
    providers=$(printf '%s' "$data" | jq -r ".$ns | keys[]" 2>/dev/null | grep -vE -- '-(ultra|super|recommended|optimized|free|tier1|tier2|tier3|tier4)$' | sort) || true
    if [[ -n "$providers" ]]; then echo "$providers"; return; fi
  fi
  echo "aviso: não foi possível derivar providers de chezmoi data ($ns)" >&2
}

is_valid_provider() {
  local agent=$1 candidate=$2 p
  for p in $(load_providers "$agent"); do
    [[ "$p" == "$candidate" ]] && return 0
  done
  return 1
}

# provider_supporters <provider> → imprime agents que suportam o provider
provider_supporters() {
  local provider=$1 a out=""
  for a in "${ALL_AGENTS[@]}"; do
    if is_valid_provider "$a" "$provider"; then
      [[ -n "$out" ]] && out="$out "
      out="$out$a"
    fi
  done
  printf '%s' "$out"
}

format_supporters() {
  local supporters=$1 n
  # shellcheck disable=SC2206
  local arr=($supporters)
  n=${#arr[@]}
  if (( n == ${#ALL_AGENTS[@]} )); then
    echo "todos os agentes"
  elif (( n == 1 )); then
    echo "${arr[0]}-only"
  else
    local IFS=", "
    echo "suportado em: ${arr[*]}"
  fi
}

get_default_provider() {
  local agent=$1 toml_key=${AGENT_DEFAULT_TOML_KEY[$1]} val
  val=$(chezmoi data --format=json 2>/dev/null | jq -r ".$toml_key // empty" 2>/dev/null) || true
  if [[ -n "$val" ]]; then
    echo "$val"
  else
    echo "navy"
  fi
}

read_state() {
  local agent=$1 file=${AGENT_STATE[$1]}
  if [[ -r "$file" ]]; then
    local p="" prof="" line key val
    while IFS=: read -r key val; do
      key=$(echo "$key" | tr -d ' ')
      val=$(echo "$val" | tr -d ' ')
      [[ "$key" == "provider" ]] && p=$val
      [[ "$key" == "profile" ]] && prof=$val
    done < "$file"
    [[ -n "$p" ]] && { echo "${p}/${prof:-$DEFAULT_PROFILE}"; return 0; }
    p=$(head -n 1 "$file" | tr -d ' \r\n')
    [[ -n "$p" ]] && { echo "${p}/$DEFAULT_PROFILE"; return 0; }
  fi
  echo "$(get_default_provider "$agent")/$DEFAULT_PROFILE"
}

write_state() {
  local agent=$1 provider=$2 profile=$3 file=${AGENT_STATE[$1]}
  mkdir -p "$(dirname "$file")"
  printf "provider:%s\nprofile:%s\n" "$provider" "$profile" > "$file"
}

apply_targets() {
  local targets=() a
  for a in "$@"; do
    local IFS='|'
    # shellcheck disable=SC2206
    local files=(${AGENT_TARGETS[$a]})
    targets+=("${files[@]}")
  done
  chezmoi apply --force "${targets[@]}"
}

cmd_status() {
  echo "Estado dos agentes:"
  local a current p prof
  for a in "${ALL_AGENTS[@]}"; do
    current=$(read_state "$a")
    p=${current%%/*}
    prof=${current##*/}
    printf "  %s: provider=%s tier=%s\n" "$a" "$p" "$prof"
  done
}

cmd_reset() {
  echo "Restaurando padrão em todos os agentes:"
  local a def
  for a in "${ALL_AGENTS[@]}"; do
    def=$(get_default_provider "$a")
    write_state "$a" "$def" "$DEFAULT_PROFILE"
    printf "  ✓ %s: %s/%s\n" "$a" "$def" "$DEFAULT_PROFILE"
  done
  apply_targets "${ALL_AGENTS[@]}"
}

cmd_dry_run() {
  local target_agent=${1:-} provider=${2:-} profile=${3:-}
  if [[ -n "$target_agent" ]]; then
    echo "[dry-run] Aplicaria em $target_agent: $provider/$profile"
    echo "[dry-run] Arquivo de state: ${AGENT_STATE[$target_agent]}"
    echo "[dry-run] Arquivos afetados: ${AGENT_TARGETS[$target_agent]}"
  else
    local supporters
    supporters=$(provider_supporters "$provider")
    if [[ -z "$supporters" ]]; then
      echo "Erro: provider '$provider' não é suportado por nenhum agente." >&2
      exit 1
    fi
    echo "[dry-run] Provider: $provider ($(format_supporters "$supporters"))"
    echo "[dry-run] Tier: $profile"
    local a
    for a in $supporters; do
      echo "[dry-run]   $a -> $provider/$profile"
    done
  fi
}

cmd_switch_single() {
  local agent=$1 provider=$2 profile=$3
  if ! is_valid_provider "$agent" "$provider"; then
    echo "Erro: provider '$provider' inválido para $agent. Providers válidos: $(load_providers "$agent" | tr '\n' ' ')" >&2
    exit 1
  fi
  write_state "$agent" "$provider" "$profile"
  apply_targets "$agent"
  echo "✓ $agent: $provider/$profile"
}

cmd_switch_all() {
  local provider=$1 profile=$2 supporters
  supporters=$(provider_supporters "$provider")
  if [[ -z "$supporters" ]]; then
    echo "Erro: provider '$provider' não é suportado por nenhum agente." >&2
    exit 1
  fi
  echo "Trocando para $provider/$profile em todos os agentes:"
  local applied_agents=() a
  for a in "${ALL_AGENTS[@]}"; do
    if is_valid_provider "$a" "$provider"; then
      write_state "$a" "$provider" "$profile"
      applied_agents+=("$a")
      printf "  ✓ %s: %s/%s\n" "$a" "$provider" "$profile"
    fi
  done
  apply_targets "${applied_agents[@]}"
}

# --- Dispatch ---
case "${1:-}" in
  status)
    cmd_status
    ;;
  reset)
    cmd_reset
    ;;
  dry-run)
    shift
    if [[ $# -eq 0 ]]; then usage; fi
    if is_agent "$1"; then
      agent=$1
      provider=${2:-}
      profile=$(normalize_profile "${3:-}")
      [[ -z "$provider" ]] && usage
      cmd_dry_run "$agent" "$provider" "$profile"
    else
      provider=$1
      profile=$(normalize_profile "${2:-}")
      cmd_dry_run "" "$provider" "$profile"
    fi
    ;;
  "")
    usage
    ;;
  *)
    if is_agent "$1"; then
      agent=$1
      provider=${2:-}
      [[ -z "$provider" ]] && usage
      profile=$(normalize_profile "${3:-}")
      cmd_switch_single "$agent" "$provider" "$profile"
    else
      provider=$1
      profile=$(normalize_profile "${2:-}")
      cmd_switch_all "$provider" "$profile"
    fi
    ;;
esac

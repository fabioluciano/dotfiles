#!/usr/bin/env bash
# Valida o source state do chezmoi sem aplicar arquivos ou atualizar ferramentas.
set -uo pipefail

mode=${1:---strict}
case $mode in
    --strict|--report) ;;
    *) printf 'uso: dotfiles-lint [--strict|--report]\n' >&2; exit 2 ;;
esac

root=$(chezmoi source-path 2>/dev/null || pwd)
scratch=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-lint.XXXXXX")
render_dir="$scratch/rendered"
failures=0
mkdir -p "$render_dir"
trap 'rm -rf -- "$scratch"' EXIT

pass() { printf 'PASS %s\n' "$1"; }
fail() { printf 'FAIL %s\n' "$1" >&2; failures=$((failures + 1)); }
skip() { printf 'SKIP %s (%s)\n' "$1" "$2"; }

run_check() {
    local name=$1 command=$2
    if sh -c "$command"; then pass "$name"; else fail "$name"; fi
}

require_check() {
    local tool=$1 name=$2 command=$3
    if ! command -v "$tool" >/dev/null 2>&1; then skip "$name" "$tool ausente"; return; fi
    run_check "$name" "$command"
}

cd "$root" || exit 1

shell_names=()
shell_paths=()
while IFS= read -r -d '' source_file; do
    [[ -f $source_file ]] || continue
    extension=${source_file##*.}
    [[ $extension == tmpl ]] && continue
    IFS= read -r first_line < "$source_file" || :
    shell=
    case $extension in
        zsh) shell=zsh ;;
        sh|bash) shell=bash ;;
        *) if [[ -x $source_file || ${source_file##*/} == executable_* ]] && [[ $first_line == '#!'* ]]; then
               case $first_line in
                   *zsh*) shell=zsh ;;
                   *bash*) shell=bash ;;
               esac
           fi ;;
    esac
    [[ -n $shell ]] || continue
    case $first_line in
        '#!'*zsh*) shell=zsh ;;
        '#!'*bash*) shell=bash ;;
    esac
    shell_names+=("$shell")
    shell_paths+=("$source_file")
done < <(git ls-files --cached --others --exclude-standard -z 2>/dev/null)

if command -v git >/dev/null 2>&1; then
    if command -v bash >/dev/null 2>&1; then
        for ((i = 0; i < ${#shell_paths[@]}; i++)); do
            [[ ${shell_names[i]} == bash ]] || continue
            source_file=${shell_paths[i]}
            if bash -n "$source_file" >/dev/null 2>&1; then pass "bash-syntax:$source_file"; else fail "bash-syntax:$source_file"; fi
        done
    else
        skip bash-syntax 'bash ausente'
    fi
    if command -v zsh >/dev/null 2>&1; then
        for ((i = 0; i < ${#shell_paths[@]}; i++)); do
            [[ ${shell_names[i]} == zsh ]] || continue
            source_file=${shell_paths[i]}
            if zsh -n "$source_file" >/dev/null 2>&1; then pass "zsh-syntax:$source_file"; else fail "zsh-syntax:$source_file"; fi
        done
    else
        skip zsh-syntax 'zsh ausente'
    fi
    if command -v shellcheck >/dev/null 2>&1; then
        for ((i = 0; i < ${#shell_paths[@]}; i++)); do
            [[ ${shell_names[i]} == bash ]] || continue
            source_file=${shell_paths[i]}
            if shellcheck --severity=warning "$source_file" >/dev/null 2>&1; then pass "shellcheck:$source_file"; else fail "shellcheck:$source_file"; fi
        done
    else
        skip shellcheck 'shellcheck ausente'
    fi
else
    skip shell-syntax 'git ausente; nao e possivel enumerar arquivos sem incluir caches ignorados'
fi

run_taplo() {
    local label=$1
    shift
    local output="$scratch/taplo-${label//\//_}.out"
    if ! command -v taplo >/dev/null 2>&1; then
        skip "$label" 'taplo ausente'
        return
    fi
    if taplo check "$@" >"$output" 2>&1; then
        pass "$label"
    elif rg -q 'Attempted to create a NULL object' "$output"; then
        skip "$label" 'Taplo panic no runtime macOS; check indisponivel neste ambiente'
    else
        cat "$output" >&2
        fail "$label"
    fi
}

toml_files=()
while IFS= read -r -d '' toml_file; do toml_files+=("$toml_file"); done < <(
    find . -path './.git' -prune -o -path './node_modules' -prune -o -type f -name '*.toml' -print0
)
if (( ${#toml_files[@]} )); then
    run_taplo toml "${toml_files[@]}"
else
    skip toml 'nenhum arquivo TOML encontrado'
fi
require_check yamllint yaml \
    "find private_dot_config/nvim -type f \\( -name '*.yaml' -o -name '*.yml' \\) -exec yamllint -d relaxed {} +"
require_check luac lua-syntax \
    "find private_dot_config/nvim -type f -name '*.lua' -exec luac -p {} +"
require_check stylua lua-format \
    "stylua --check private_dot_config/nvim"

run_selene() {
    local selene_bin
    if command -v selene >/dev/null 2>&1 && selene --version >/dev/null 2>&1; then
        selene_bin=$(command -v selene)
    elif command -v mise >/dev/null 2>&1 && selene_bin=$(mise where 'aqua:Kampfkarren/selene' 2>/dev/null)/selene && [[ -x $selene_bin ]]; then
        :
    else
        skip lua-lint 'selene ausente ou nao ativado'
        return
    fi
    if "$selene_bin" --config private_dot_config/nvim/selene.toml private_dot_config/nvim; then
        pass lua-lint
    else
        fail lua-lint
    fi
}

run_selene
run_check git-diff "git diff --check"
require_check /usr/bin/python3 xfce-xml \
    "/usr/bin/python3 -B .chezmoitemplates/xfce/test_render.py"
require_check /usr/bin/python3 plank-organization \
    "/usr/bin/python3 -B .chezmoitemplates/plank/test_organize.py"
require_check /usr/bin/python3 security-bootstrap-regressions \
    "/usr/bin/python3 -B -m unittest discover -s .chezmoitemplates/git"

render_shell_template() {
    local template rendered shell first_line
    template=$1
    rendered="$render_dir/${template//\//_}"
    if ! chezmoi execute-template < "$template" > "$rendered" 2>/dev/null; then
        fail "template:$template"
        return
    fi
    if [[ ! -s $rendered ]]; then
        skip "template:$template" 'render vazio neste ambiente'
        return
    fi
    IFS= read -r first_line < "$rendered" || :
    case $template in
        *.zsh.tmpl|private_dot_zshenv.tmpl|dot_zshrc.tmpl) shell=zsh ;;
        *) shell=bash ;;
    esac
    case $first_line in
        '#!'*zsh*) shell=zsh ;;
        '#!'*bash*) shell=bash ;;
    esac
    if ! command -v "$shell" >/dev/null 2>&1; then
        skip "template:$template" "$shell ausente"
        return
    fi
    if "$shell" -n "$rendered" >/dev/null 2>&1; then
        pass "template:$template"
    else
        fail "template:$template"
        return
    fi
    if [[ $shell == bash ]] && command -v shellcheck >/dev/null 2>&1; then
        if shellcheck --severity=warning "$rendered" >/dev/null 2>&1; then
            pass "shellcheck:template:$template"
        else
            fail "shellcheck:template:$template"
        fi
    fi
}

if command -v chezmoi >/dev/null 2>&1; then
    shell_templates=()
    while IFS= read -r -d '' template; do
        case $template in
            *.sh.tmpl|*.bash.tmpl|*.zsh.tmpl|private_dot_zshenv.tmpl|dot_zshrc.tmpl)
                shell_templates+=("$template")
                ;;
        esac
    done < <(git ls-files --cached --others --exclude-standard -z 2>/dev/null)
    if (( ${#shell_templates[@]} )); then
        for template in "${shell_templates[@]}"; do render_shell_template "$template"; done
    else
        skip shell-templates 'nenhum template shell encontrado'
    fi
    if chezmoi execute-template < private_dot_config/mise/config.toml.tmpl > "$render_dir/mise.toml"; then
        run_taplo template:mise "$render_dir/mise.toml"
    else
        fail template:mise
    fi
    if chezmoi execute-template < dot_Brewfile.tmpl > "$render_dir/Brewfile"; then
        if command -v ruby >/dev/null 2>&1; then
            if ruby -c "$render_dir/Brewfile"; then pass template:Brewfile; else fail template:Brewfile; fi
        else
            skip template:Brewfile 'ruby ausente'
        fi
    else
        fail template:Brewfile
    fi
else
    skip templates 'chezmoi ausente'
fi

printf 'SUMMARY failures=%d mode=%s\n' "$failures" "${mode#--}"
if [[ $mode == --strict && $failures -ne 0 ]]; then exit 1; fi
exit 0

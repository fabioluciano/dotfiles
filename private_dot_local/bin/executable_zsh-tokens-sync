#!/usr/bin/env bash
set -euo pipefail
# Resolve API tokens from the Bitwarden item "dotfiles-tokens" ONCE and write
# them as ready-to-source `export` lines into ~/.config/zsh/tokens.zsh (mode
# 600), which ~/.zshenv sources. This keeps secrets out of the git repo and out
# of every shell's startup path (no `bw`/`python` at shell init).
#
# Run this manually whenever a token rotates. It is also invoked automatically
# by the chezmoi run_onchange script on apply. Gracefully no-ops (keeping any
# existing tokens file) when `bw` is missing or the vault is locked.

OUT="${XDG_CONFIG_HOME:-$HOME/.config}/zsh/tokens.zsh"
ITEM="dotfiles-tokens"
umask 077

# Bitwarden custom-field name  ->  exported environment variable
MAP=(
  "github_token=GITHUB_TOKEN"
  "gitlab_token=GITLAB_TOKEN"
  "bitbucket_token=BITBUCKET_TOKEN"
  "jira_token=JIRA_TOKEN"
  "jira_email=JIRA_EMAIL"
  "jira_domain=JIRA_DOMAIN"
  "work_mail=WORK_MAIL"
  "anthropic_api_key=ANTHROPIC_API_KEY"
  "mimo_api_key=MIMO_API_KEY"
  "openai_api_token=OPENAI_API_KEY"
  "opencode_api_key=OPENCODE_API_KEY"
  "opencode_go_api_key=OPENCODE_GO_API_KEY"
  "opencode_zen_api_key=OPENCODE_ZEN_API_KEY"
  "minimax_api_token=MINIMAX_API_KEY"
  "deepseek_api_token=DEEPSEEK_API_KEY"
  "zai_api_token=ZAI_API_KEY"
  "kimicode_api_token=KIMI_CODE_API_KEY"
  "qwencloud_api_token=QWENCLOUD_API_TOKEN"
  "gemini_api_key=GEMINI_API_KEY"
  "google_api_key=GOOGLE_API_KEY"
  "commandcode_api_key=COMMANDCODE_API_KEY"
  "navyai_api_key=NAVYAI_API_KEY"
  "tokenra_api_key=TOKENRA_API_KEY"
  "freellmapi_api_key=FREELITELLM_API_KEY"
)
if ! bw unlock --check >/dev/null 2>&1; then
  if [ -c /dev/tty ] && [ -r /dev/tty ] && [ -w /dev/tty ]; then
    if raw_session="$(bw unlock --raw </dev/tty 2>/dev/tty)"; then
      export BW_SESSION="$raw_session"
    fi
  fi
fi

if ! bw unlock --check >/dev/null 2>&1; then
  echo "zsh-tokens-sync: vault bloqueado; mantendo tokens atuais." >&2
  exit 0
fi

item_json="$(bw get item "$ITEM" 2>/dev/null)" || {
  echo "zsh-tokens-sync: item '$ITEM' nao encontrado." >&2; exit 0;
}

command -v jq >/dev/null 2>&1 || {
  echo "zsh-tokens-sync: jq nao instalado; mantendo tokens atuais." >&2
  exit 1
}

if ! printf '%s' "$item_json" | jq -e '
  [.fields[]?.name] | group_by(.) | all(.[]; length == 1)
' >/dev/null; then
  echo "zsh-tokens-sync: campos duplicados no item; mantendo tokens atuais." >&2
  exit 1
fi

# Remove espaços e quebras de linha nas pontas do valor (colar o token no
# Bitwarden costuma deixar um \n ou \r no final). Não mexe no miolo.
trim() {
    local s=$1
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    printf '%s' "$s"
}

field_value() {
  local field=$1
  printf '%s' "$item_json" | jq -r --arg field "$field" '
    first(.fields[]? | select(.name == $field) | .value // "") // ""
  '
}

# POSIX single-quote escaping so the value is safe to source in zsh/bash.
# (Substitution done in an assignment — inside double quotes the backslashes
# would be taken literally and the escaping would break.)
sq() { local s=${1//\'/\'\\\'\'}; printf "'%s'" "$s"; }

mkdir -p "$(dirname "$OUT")"

_atomic_write_tokens() (
  set -euo pipefail
  local tmp export_count=0
  tmp="$(mktemp "${OUT}.tmp.XXXXXX")"
  trap 'rm -f -- "$tmp"' EXIT
  {
    echo "# Generated by zsh-tokens-sync — DO NOT edit, DO NOT commit."
    echo "# Secrets resolved from Bitwarden item '$ITEM'."
    for pair in "${MAP[@]}"; do
      field="${pair%%=*}"; var="${pair#*=}"
      val="$(trim "$(field_value "$field")")"
      if [ -n "$val" ]; then
        # Caractere de controle no miolo: ignora só este campo (sem imprimir o
        # valor) em vez de abortar o item inteiro. Corrija-o no Bitwarden.
        if [[ $val =~ [[:cntrl:]] ]]; then
          echo "zsh-tokens-sync: campo '$field' tem caractere de controle; ignorado." >&2
          continue
        fi
        printf 'export %s=%s\n' "$var" "$(sq "$val")"
        export_count=$((export_count + 1))
      fi
    done
  } > "$tmp"
  [[ -s "$tmp" ]] && (( export_count > 0 )) || {
    echo "zsh-tokens-sync: nenhum export encontrado; mantendo tokens atuais." >&2
    return 1
  }
  bash -n "$tmp"
  chmod 600 "$tmp"
  mv -f -- "$tmp" "$OUT"
  trap - EXIT
)

_atomic_write_tokens
echo "zsh-tokens-sync: $OUT atualizado."

#!/usr/bin/env bash
set -euo pipefail

PROFILES=(optimized moderate super ultra recommended)
DEFAULT_PROFILE="moderate"
STATE_FILE="${HOME}/.config/opencode/.active_provider"
TARGET_FILES=(
  "${HOME}/.config/opencode/oh-my-openagent.jsonc"
  "${HOME}/.config/opencode/opencode.jsonc"
  "${HOME}/.config/opencode/omo.jsonc"
  "${HOME}/.config/opencode/omo-slim.jsonc"
  "${HOME}/.config/opencode/oh-my-opencode-slim.json"
  "${HOME}/.config/cortexkit/magic-context.jsonc"
)

usage() {
  cat >&2 <<EOF
Uso:
  $(basename "$0") <provider> [profile]
  $(basename "$0") dry-run <provider> [profile]
  $(basename "$0") status
  $(basename "$0") reset

Profiles disponíveis: ${PROFILES[*]} (padrão: ${DEFAULT_PROFILE})
EOF
  exit 1
}

read_state() {
  if [[ ! -f "$STATE_FILE" ]]; then
    printf 'provider:%s\nprofile:%s\n' "${DEFAULT_PROVIDER:-xiaomi}" "$DEFAULT_PROFILE"
    return 0
  fi

  cat "$STATE_FILE"
}

print_status() {
  local state provider profile
  state=$(read_state)
  provider=$(printf '%s\n' "$state" | awk -F: '/^provider:/{print $2}')
  profile=$(printf '%s\n' "$state" | awk -F: '/^profile:/{print $2}')

  provider=${provider:-${DEFAULT_PROVIDER:-xiaomi}}
  profile=${profile:-$DEFAULT_PROFILE}

  echo "Provider ativo: $provider"
  echo "Profile ativo: $profile"
  echo "Arquivo de estado: $STATE_FILE"
  echo "Targets renderizados: ${TARGET_FILES[*]}"
}

write_state() {
  local provider=$1 profile=$2
  mkdir -p "$(dirname "$STATE_FILE")"
  cat > "$STATE_FILE" <<EOF
provider:${provider}
profile:${profile}
EOF
  chmod 600 "$STATE_FILE"
}

apply_target() {
  # `--force` is needed because at least one of these targets
  # (`oh-my-openagent.jsonc`) is a chezmoi-managed file that the user might
  # have removed or edited by hand; chezmoi would otherwise block on a TTY
  # prompt that fails in non-interactive shells (SSH, scripts, agent
  # sessions). The state file is the source of truth; the target files are
  # derived from it. If a target is genuinely unmanaged, chezmoi prints
  # "not managed" and we move on.
  chezmoi apply --force "${TARGET_FILES[@]}"
}

load_providers() {
  # Extract providers and default_provider from chezmoi data (opencode_providers.toml)
  # in a single chezmoi data call. Falls back to hardcoded values when chezmoi is
  # unavailable or parsing fails.
  local chezmoi_data providers_from_toml default_from_toml
  chezmoi_data=$(chezmoi data --format=json 2>/dev/null) || true
  providers_from_toml=""
  default_from_toml=""
  if [[ -n "$chezmoi_data" ]]; then
    providers_from_toml=$(printf '%s' "$chezmoi_data" \
      | jq -r '.opencode.models | keys[]' 2>/dev/null | sort) || true
    default_from_toml=$(printf '%s' "$chezmoi_data" \
      | jq -r '.opencode.default_provider // empty' 2>/dev/null) || true
  fi
  if [[ -n "$providers_from_toml" ]]; then
    mapfile -t PROVIDERS <<< "$providers_from_toml"
  else
    PROVIDERS=(alibaba-token-plan deepseek minimax kimicode openai opencode xiaomi zai zen-free)
  fi
  DEFAULT_PROVIDER="${default_from_toml:-xiaomi}"
}

is_valid_provider() {
  local candidate=$1
  local provider
  for provider in "${PROVIDERS[@]}"; do
    [[ "$provider" == "$candidate" ]] && return 0
  done
  return 1
}

normalize_profile() {
  local input=${1:-$DEFAULT_PROFILE}
  if [[ "$input" == "default" ]]; then
    echo "$DEFAULT_PROFILE"
    return 0
  fi

  local profile
  for profile in "${PROFILES[@]}"; do
    if [[ "$profile" == "$input" ]]; then
      echo "$profile"
      return 0
    fi
  done

  echo "Perfil inválido: $input. Perfis válidos: ${PROFILES[*]}." >&2
  exit 1
}

if [[ $# -lt 1 || $# -gt 3 ]]; then
  usage
fi

command_name=$1

case "$command_name" in
  status)
    [[ $# -eq 1 ]] || usage
    print_status
    exit 0
    ;;
  reset)
    [[ $# -eq 1 ]] || usage
    load_providers
    write_state "$DEFAULT_PROVIDER" "$DEFAULT_PROFILE"
    apply_target
    print_status
    exit 0
    ;;
  dry-run)
    [[ $# -ge 2 && $# -le 3 ]] || usage
    provider=$2
    profile=$(normalize_profile "${3:-$DEFAULT_PROFILE}")
    load_providers
    is_valid_provider "$provider" || {
      echo "Erro: provider inválido '$provider'." >&2
      echo "Providers válidos: ${PROVIDERS[*]}" >&2
      exit 1
    }

    echo "Dry run"
    echo "Provider alvo: $provider"
    echo "Profile alvo: $profile"
    echo "Arquivo de estado: $STATE_FILE"
    echo "Targets renderizados: ${TARGET_FILES[*]}"
    exit 0
    ;;
esac

provider=$1
profile=$(normalize_profile "${2:-$DEFAULT_PROFILE}")

# Fast no-op path: skip chezmoi data and apply if the desired state is already active.
current_state=$(read_state)
current_provider=$(printf '%s\n' "$current_state" | awk -F: '/^provider:/{print $2}')
current_profile=$(printf '%s\n' "$current_state" | awk -F: '/^profile:/{print $2}')
if [[ "$current_provider" == "$provider" && "$current_profile" == "$profile" ]]; then
  echo "Provider '$provider' com profile '$profile' já está ativo. Pulando apply."
  print_status
  exit 0
fi

load_providers

is_valid_provider "$provider" || {
  echo "Erro: provider inválido '$provider'." >&2
  echo "Providers válidos: ${PROVIDERS[*]}" >&2
  exit 1
}

write_state "$provider" "$profile"
apply_target
print_status

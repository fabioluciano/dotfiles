#!/usr/bin/env zsh
# Synchronize safely loaded vault exports into the tmux server environment.
set -euo pipefail

# The tmux server exists during config loading even when it has no sessions.
[[ -n "${TMUX:-}" ]] || exit 0
if [[ -n "${GITHUB_TOKEN:-}" ]]; then
    command tmux set-environment -g GITHUB_TOKEN "$GITHUB_TOKEN"
fi

(( $+functions[zsh-load-tokens] )) || exit 0
zsh-load-tokens || exit 0

for variable in "${_ZSH_TOKEN_VARS[@]}"; do
    if [[ -n "${(P)variable:-}" ]]; then
        command tmux set-environment -g "$variable" "${(P)variable}"
    fi
done

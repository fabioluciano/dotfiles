#!/usr/bin/env bash
# Starts only dock1 on the primary monitor. The filename is a legacy entry point.
set -euo pipefail

command -v plank >/dev/null 2>&1 || exit 0
command -v xrandr >/dev/null 2>&1 || exit 0
command -v gsettings >/dev/null 2>&1 || exit 0

mapfile -t outputs < <(xrandr --query | awk '/ connected/ {print $1}')
(( ${#outputs[@]} > 0 )) || exit 0

primary=$(xrandr --query | awk '/ primary/ {print $1; exit}')
[[ -n "${primary}" ]] || primary=${outputs[0]}

schema="net.launchpad.plank.dock.settings:/net/launchpad/plank/docks/dock1/"
gsettings set "${schema}" monitor "${primary}"
gsettings set "${schema}" active-display false

is_running() {
    local name=$1
    # Instância iniciada sem -n (autostart antigo) também conta como dock1.
    if [[ "${name}" == "dock1" ]] && pgrep -f '^([^[:space:]]*/)?plank$' >/dev/null 2>&1; then
        return 0
    fi
    pgrep -f "^([^[:space:]]*/)?plank -n ${name}$" >/dev/null 2>&1
}

if ! is_running dock1; then
    setsid -f plank -n dock1 >/dev/null 2>&1
fi

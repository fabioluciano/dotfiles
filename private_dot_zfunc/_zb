(( $+functions[_zb_commands] )) ||
_zb_commands() {
    local commands; commands=(
'install:Install formulas and casks' \
'bundle:Install or dump from a Brewfile' \
'uninstall:Uninstall formulas and casks' \
'migrate:Migrate packages from Homebrew' \
'list:List installed packages' \
'info:Show information about an installed package' \
'doctor:Run diagnostics and optionally repair issues' \
'gc:Remove unreferenced store entries' \
'reset:Reset zerobrew data directories' \
'init:Initialize zerobrew directories' \
'completion:Generate shell completions' \
'run:Run an installed formula as a command' \
'update:Refresh cached formula metadata' \
'outdated:List installed packages with newer versions available' \
'upgrade:Upgrade installed packages to the latest versions' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'zb commands' commands "$@"
}

#compdef change-providers
# shellcheck shell=bash disable=SC2034,SC2206,SC2296

_change-providers() {
  local -a commands providers profiles

  commands=(
    'status:mostrar estado de todos os agentes'
    'reset:restaurar todos para o provider/tier padrão'
    'dry-run:mostrar mudança sem aplicar'
  )

  {{- /* Providers = keys do registry no providers.toml (comuns aos agentes). */ -}}
  providers=(
  {{- if .providers }}
  {{- range $p := keys .providers | sortAlpha }}
    '{{ $p }}'
  {{- end }}
  {{- else }}
    'navy' 'google' 'xiaomi'
  {{- end }}
  )

  profiles=(
    'recommended:tier flagship / modelos de máxima capacidade'
    'optimized:tier balanceado / modelos médios (padrão)'
    'super:tier econômico / modelos leves de baixo consumo'
    'ultra:tier custo mínimo / modelos rápidos'
    'free:tier gratuito / sem consumo de tokens pagos'
  )

  local cur="${words[CURRENT]-}"

  # Position 2: command or provider (agents fora do autocomplete — troca é
  # sempre em todos).
  if (( CURRENT == 2 )); then
    _describe 'command' commands
    _describe 'provider' providers
    return
  fi

  # Resolve what word[2] is
  local w2="${words[2]-}"
  case "$w2" in
    status|reset)
      return
      ;;
    dry-run)
      # word[3]: provider (sem agents no autocomplete)
      if (( CURRENT == 3 )); then
        _describe 'provider' providers
      elif (( CURRENT == 4 )); then
        _describe 'tier' profiles
      fi
      return
      ;;
    opencode|omp|pi|codewhale|maka|crush)
      # Digitado manualmente: word[3]: provider, word[4]: tier
      if (( CURRENT == 3 )); then
        _describe 'provider' providers
      elif (( CURRENT == 4 )); then
        _describe 'tier' profiles
      fi
      return
      ;;
    *)
      # word[2] was a provider; word[3]: tier
      if (( CURRENT == 3 )); then
        _describe 'tier' profiles
      fi
      ;;
  esac
}

_change-providers "$@"

#compdef oc-provider
# shellcheck shell=bash disable=SC2034,SC2206,SC2296

_oc-provider() {
  local -a commands providers profiles

  commands=(
    'status:mostrar provider/profile atuais'
    'reset:restaurar provider/profile padrão'
    'dry-run:mostrar mudança sem aplicar'
  )

  providers=(
  {{- if .opencode.models }}
  {{-   range $p, $_ := .opencode.models }}
    '{{ $p }}'
  {{-   end }}
  {{- else }}
    'alibaba-token-plan' 'deepseek' 'minimax' 'kimicode' 'openai' 'opencode' 'xiaomi' 'zai' 'zen-free'
  {{- end }}
  )

  profiles=(
    'optimized:~28% economia — medium rotineiras, high críticas'
    'moderate:alias para optimized'
    'super:~38% economia — low/medium na maioria'
    'ultra:custo mínimo absoluto'
    'recommended:tiers do Oh My OpenAgent'
  )

  if (( CURRENT == 2 )); then
    _describe 'command' commands
    _describe 'provider' providers
    return
  fi

  case "${words[2]-}" in
    status|reset)
      return
      ;;
    dry-run)
      if (( CURRENT == 3 )); then
        _describe 'provider' providers
      elif (( CURRENT == 4 )); then
        _describe 'profile' profiles
      fi
      return
      ;;
    *)
      if (( CURRENT == 3 )); then
        _describe 'profile' profiles
      fi
      ;;
  esac
}

_oc-provider "$@"

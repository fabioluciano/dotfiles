# Chezmoi ignore file
# Files and directories listed here will not be copied to the destination

# Documentation
README.md
AGENTS.md
LICENSE
docs/

# Version control
.git/

# Editor and IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.bak
*.backup
*.log

# OS-specific files
.DS_Store

# npm/yarn/pnpm install artifacts — managed by the opencode binary's own
# package cache (~/.cache/opencode/packages/), not by chezmoi. Lives under
# private_dot_config/opencode/ because the source state is just a meta
# directory (package.json, package-lock.json) that gets copied verbatim;
# running `npm install` in there pollutes the diff with thousands of
# generated files. Same for the `node_modules` dir under the opencode
# config in HOME.
**/node_modules

# Platform-specific configurations
{{- if ne .chezmoi.os "linux" }}
# Ignore Linux-specific files when not on Linux
.XCompose
.config/autostart
.config/compiz-1
.config/cortile
.config/fontconfig
.config/vicinae
.config/xfce4
.config/yay
.Pacmanfile
logid.cfg
{{- end }}

{{- if ne .chezmoi.os "darwin" }}
# Ignore macOS-specific files when not on macOS
.Brewfile
Library
{{- end }}

{{- if eq .chezmoi.os "darwin" }}
# macOS Zed uses ~/Library/Application Support/Zed, not ~/.config/zed
.config/zed
# Maka uses ~/Library/Application Support/Maka on macOS; keep the Linux
# ~/.config/Maka source variant available for Arch machines.
.config/Maka
{{- end }}


# Public GPG key — usado pelos run_before, nao aplicar em ~
keys/


# Generated by antidote (zsh plugin manager) — not tracked by chezmoi
.zsh_plugins.zsh

# opencode skills: geridas pela `skills` CLI (npx skills add), NAO pelo chezmoi
.config/opencode/skills/

{{- /* Configuração global do pi (earendil-works/pi). Renderiza
     `~/.pi/agent/settings.json` a partir de uma state file em
     `~/.config/pi/.active_provider` (provider:foo\nprofile:bar) +
     `.chezmoidata/providers.toml`. */ -}}
{{- $state := includeTemplate "pi-state.tmpl" . | fromJson -}}
{{- $liveJSON := output "sh" "-c" "jq -c '{theme:(.theme // \"tokyo-night\"), lastChangelogVersion:(.lastChangelogVersion // \"0.0.0\"), packages:(.packages // []), showHardwareCursor:(.showHardwareCursor // true), showCacheMissNotices:(.showCacheMissNotices // true)}' \"$HOME/.pi/agent/settings.json\" 2>/dev/null || echo '{}'" | trim | default "{}" -}}
{{- $live := $liveJSON | fromJson -}}
{{- $liveTheme := get $live "theme" | default "tokyo-night" -}}
{{- $liveLastChangelog := get $live "lastChangelogVersion" | default "0.0.0" -}}
{{- $livePackages := get $live "packages" | default (list) | toJson -}}
{{- $liveShowHardwareCursor := get $live "showHardwareCursor" | default true -}}
{{- $liveShowCacheMissNotices := get $live "showCacheMissNotices" | default true -}}
{
  "theme": "{{ $liveTheme }}",
  "themes": [
    "themes"
  ],
  "defaultProjectTrust": "always",
  "enableInstallTelemetry": false,
  "packages": {{ $livePackages }},
  "defaultProvider": "{{ $state.providerId }}",
  "defaultModel": "{{ $state.defaultModel }}",
  "showHardwareCursor": {{ $liveShowHardwareCursor }},
  "terminal": {
    "showTerminalProgress": true
  },
  "showCacheMissNotices": {{ $liveShowCacheMissNotices }},
  "warnings": {
    "anthropicExtraUsage": true
  },
  "lastChangelogVersion": "{{ $liveLastChangelog }}"
}

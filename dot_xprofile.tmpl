{{- if eq .chezmoi.os "linux" -}}
# ~/.xprofile — ambiente da sessão X11 (gerenciado pelo chezmoi)
# Espelhado em ~/.config/environment.d/90-nvidia.conf para serviços
# systemd --user (ex.: apps lançados pelo Vicinae).
export LIBVA_DRIVER_NAME=nvidia
export MOZ_DISABLE_RDD_SANDBOX=1

# NVIDIA VSync: prender ao monitor principal de 165 Hz evita sincronizar no secundário de 60 Hz.
export __GL_SYNC_TO_VBLANK=1
export __GL_SYNC_DISPLAY_DEVICE=DP-2
# shortcut: apps fullscreen podem preferir 0 via nvidia-settings por sessão, when gaming.


# Garante que unidades de usuário (ex.: vicinae.service) recebam o ambiente
# gráfico da sessão X11.
if command -v systemctl >/dev/null 2>&1; then
    systemctl --user import-environment DISPLAY XAUTHORITY 2>/dev/null || true
fi
{{- end }}

[[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/aliases.zsh" ]]  && source "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/aliases.zsh"
[[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/security.zsh" ]] && source "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/security.zsh"
[[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/aiagents.zsh" ]] && source "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/aiagents.zsh"


{{- /* Maka credentials ($XDG_CONFIG_HOME/Maka/workspaces/default/credentials.json;
     fallback ~/.config/Maka)
     Secrets injetados via env do chezmoi a partir dos tokens sincronizados. */ -}}
{
  "version": 1,
  "values": {
    {{- $entries := list }}
    {{- if or (env "OPENCODE_GO_API_KEY") (env "OPENCODE_API_KEY") }}
      {{- $entries = append $entries (printf "\"opencode-go:apiKey\": %q" (env "OPENCODE_GO_API_KEY" | default (env "OPENCODE_API_KEY"))) }}
    {{- end }}
    {{- if env "DEEPSEEK_API_KEY" }}
      {{- $entries = append $entries (printf "\"deepseek:apiKey\": %q" (env "DEEPSEEK_API_KEY")) }}
    {{- end }}
    {{- if env "MIMO_API_KEY" }}
      {{- $entries = append $entries (printf "\"xiaomi-token-plan-sgp:apiKey\": %q" (env "MIMO_API_KEY")) }}
    {{- end }}
    {{- if or (env "GEMINI_API_KEY") (env "GOOGLE_API_KEY") }}
      {{- $entries = append $entries (printf "\"google:apiKey\": %q" (env "GEMINI_API_KEY" | default (env "GOOGLE_API_KEY"))) }}
    {{- end }}
    {{- if or (env "NAVYAI_API_KEY") (env "NAVY_API_KEY") }}
      {{- $entries = append $entries (printf "\"navy:apiKey\": %q" (env "NAVYAI_API_KEY" | default (env "NAVY_API_KEY"))) }}
    {{- end }}
    {{- if env "MINIMAX_API_KEY" }}
      {{- $entries = append $entries (printf "\"minimax:apiKey\": %q" (env "MINIMAX_API_KEY")) }}
    {{- end }}
    {{- if env "ZAI_API_KEY" }}
      {{- $entries = append $entries (printf "\"zai:apiKey\": %q" (env "ZAI_API_KEY")) }}
    {{- end }}
    {{- join ",\n    " $entries }}
  }
}

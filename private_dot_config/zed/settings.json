    "csv": true,
    "docker-compose": true,
    "dockerfile": true,
    "emmet": true,
    "env": true,
    "git-firefly": true,
    "graphql": true,
    "groovy": true,
    "helm": true,
    "html": true,
    "ini": true,
    "java": true,
    "jinja2": true,
    "just": true,
    "log": true,
    "lua": true,
    "make": true,
    "material-icon-theme": true,
    "mcp-server-context7": true,
    "mcp-server-github": true,
    "mermaid": true,
    "pylsp": true,
    "sql": true,
    "terraform": true,
    "tokyo-night": true,
    "tombi": true,
    "toml": true,
    "typst": true,
    "xml": true
  }

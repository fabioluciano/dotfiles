{
  "agent_servers": {
    "OpenCode": {
      "command": "opencode",
      "args": ["acp"]
    }
  },
  "cli_default_open_behavior": "existing_window",
  "edit_predictions": {
    "provider": "copilot"
  },
  "agent": {
    "default_model": {
      "provider": "opencode",
      "model": "free/big-pickle",
      "enable_thinking": false
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "terminal": {
    "font_size": 13.0
  },
  "proxy": "",
  "git_panel": {
    "tree_view": true,
    "file_icons": true
  },
  "project_panel": {
    "git_status_indicator": true,
    "bold_folder_labels": true,
    "dock": "left"
  },
  "which_key": {
    "enabled": true
  },
  "buffer_font_family": "Maple Mono NF",
  "session": {
    "trust_all_worktrees": true
  },
  "icon_theme": "Material Icon Theme",
  "ui_font_size": 16,
  "buffer_font_size": 13.0,
  "theme": "Tokyo Night",
  "auto_install_extensions": {
    "ansible": true,
    "asciidoc": true,
    "astro": true,
    "biome": true,
    "cargo-tom": true,
    "codebook": true,
    "color-highlight": true,

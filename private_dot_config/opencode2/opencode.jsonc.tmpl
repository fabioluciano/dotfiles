{{- $state := includeTemplate "opencode2-state.tmpl" . | fromJson -}}
{{- $provider := $state.provider -}}
{{- $profile := $state.profile -}}
{{- $providerModels := $state.providerModels -}}
{{- $enabledProviders := list -}}
{{- range $pkey := without (sortAlpha (keys $.opencode.models)) "zen-free" -}}
{{- $enabledProviders = append $enabledProviders (get (index $.providers $pkey) "opencode_id" | default $pkey) -}}
{{- end -}}
{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [],
  "model": "{{ first (index $providerModels "orchestrator") }}",
  "small_model": "{{ first (index $providerModels "quick") }}",
  "default_agent": "build",
  "agent": {
    "build": {
      "model": "{{ first (index $providerModels "implementation") }}"
    },
    "plan": {
      "model": "{{ first (index $providerModels "planner") }}"
    }{{- range $agent, $tier := $.opencode.agent_profiles }}
{{- $tierModels := index $providerModels $tier -}}
{{- $stdModels := index $providerModels "standard" -}}
{{- $orchModels := index $providerModels "orchestrator" -}}
{{- $chain := or $tierModels $stdModels $orchModels }}
    ,"{{ $agent }}": {
      "model": "{{ first $chain }}"
    }
{{- end }}
  },
  "formatter": true,
  "lsp": {
    "marksman": {
      "command": [
        "marksman",
        "server"
      ],
      "extensions": [
        ".md",
        ".markdown"
      ]
    },
    "yaml-language-server": {
      "command": [
        "yaml-language-server",
        "--stdio"
      ],
      "extensions": [
        ".yaml",
        ".yml"
      ]
    },
    "dockerfile-language-server": {
      "command": [
        "docker-langserver",
        "--stdio"
      ],
      "extensions": [
        ".dockerfile"
      ]
    },
    "helm-ls": {
      "command": [
        "helm_ls",
        "serve"
      ],
      "extensions": [
        ".yaml",
        ".yml"
      ]
    },
    "tailwindcss-language-server": {
      "command": [
        "tailwindcss-language-server",
        "--stdio"
      ],
      "extensions": [
        ".html",
        ".css",
        ".js",
        ".jsx",
        ".ts",
        ".tsx",
        ".vue",
        ".svelte"
      ]
    },
    "vue-language-server": {
      "command": [
        "vue-language-server",
        "--stdio"
      ],
      "extensions": [
        ".vue"
      ]
    },
    "zls": {
      "command": [
        "zls"
      ],
      "extensions": [
        ".zig",
        ".zon"
      ]
    },
    "tinymist": {
      "command": [
        "tinymist",
        "lsp"
      ],
      "extensions": [
        ".typ"
      ]
    },
    "pyright": {
      "disabled": true
    },
    "basedpyright": {
      "command": [
        "uvx",
        "--from",
        "basedpyright",
        "basedpyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    },
    "jdtls": {
      "command": [
        "jdtls"
      ],
      "extensions": [
        ".java",
        ".groovy"
      ]
    },
    "taplo": {
      "command": [
        "taplo",
        "lsp",
        "stdio"
      ],
      "extensions": [
        ".toml"
      ]
    },
    "sql-language-server": {
      "command": [
        "sql-language-server",
        "up",
        "--method",
        "stdio"
      ],
      "extensions": [
        ".sql"
      ]
    },
    "cmake-language-server": {
      "command": [
        "cmake-language-server"
      ],
      "extensions": [
        "CMakeLists.txt",
        ".cmake"
      ]
    },
    "mdx-language-server": {
      "command": [
        "mdx-language-server",
        "--stdio"
      ],
      "extensions": [
        ".mdx"
      ]
    },
    "docker-compose-langserver": {
      "command": [
        "docker-compose-langserver",
        "--stdio"
      ],
      "extensions": [
        "docker-compose.yml",
        "docker-compose.yaml",
        "compose.yml",
        "compose.yaml"
      ]
    },
    "vscode-css-language-server": {
      "command": [
        "vscode-css-language-server",
        "--stdio"
      ],
      "extensions": [
        ".css",
        ".scss",
        ".less"
      ]
    },
    "vscode-html-language-server": {
      "command": [
        "vscode-html-language-server",
        "--stdio"
      ],
      "extensions": [
        ".html",
        ".htm"
      ]
    },
    "vscode-json-language-server": {
      "command": [
        "vscode-json-language-server",
        "--stdio"
      ],
      "extensions": [
        ".json",
        ".jsonc"
      ]
    },
    "vscode-eslint-language-server": {
      "command": [
        "vscode-eslint-language-server",
        "--stdio"
      ],
      "extensions": [
        ".js",
        ".jsx",
        ".ts",
        ".tsx",
        ".mjs",
        ".cjs"
      ]
    },
    "gopls": {
      "command": [
        "gopls"
      ],
      "extensions": [
        ".go"
      ]
    },
    "rust-analyzer": {
      "command": [
        "rust-analyzer"
      ],
      "extensions": [
        ".rs"
      ]
    },
    "lua-language-server": {
      "command": [
        "lua-language-server"
      ],
      "extensions": [
        ".lua"
      ]
    },
    "bash-language-server": {
      "command": [
        "bash-language-server",
        "start"
      ],
      "extensions": [
        ".sh",
        ".bash",
        ".zsh"
      ]
    },
    "typescript-language-server": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs"
      ]
    },
    "elixir-ls": {
      "command": [
        "elixir-ls"
      ],
      "extensions": [
        ".ex",
        ".exs"
      ]
    },
    "intelephense": {
      "command": [
        "intelephense",
        "--stdio"
      ],
      "extensions": [
        ".php"
      ]
    },
    "ruff": {
      "command": [
        "ruff",
        "server"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    }
  },
  "enabled_providers": {{ toJson $enabledProviders }},
  "compaction": {
    "auto": false,
    "prune": false,
    "reserved": 6000
  },
  "watcher": {
    "ignore": [
      ".git",
      "node_modules",
      "dist",
      "build",
      ".next",
      ".nuxt",
      ".output",
      ".cache",
      "coverage",
      "*.log",
      ".turbo",
      ".venv",
      "__pycache__",
      "target"
    ]
  },
  "instructions": [
    "~/.config/AGENTS.md"
  ],
  "provider": {
    "navy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Navy",
      "options": {
        "baseURL": "https://api.navy/v1",
        "apiKey": "{env:NAVYAI_API_KEY}"
      },
      "models": {
        "claude-sonnet-5": { "name": "Claude Sonnet 5 (NavyAI)" },
        "claude-opus-5": { "name": "Claude Opus 5 (NavyAI)" },
        "claude-haiku-4.5": { "name": "Claude Haiku 4.5 (NavyAI)" },
        "deepseek-v4-pro": { "name": "DeepSeek V4 Pro (Free)" },
        "deepseek-v4-flash": { "name": "DeepSeek V4 Flash (Free)" },
        "deepseek-chat": { "name": "DeepSeek Chat (Free)" },
        "deepseek-reasoner": { "name": "DeepSeek Reasoner (Free)" },
        "codestral-latest": { "name": "Codestral (Free)" },
        "mistral-large-latest": { "name": "Mistral Large (Free)" },
        "hermes-4-405b": { "name": "Nous Hermes 405B (Free)" },
        "grok-code-fast-1": { "name": "Grok Code Fast 1 (Free)" },
        "gemini-2.0-flash": { "name": "Gemini 2.0 Flash (Free)" },
        "gemini-2.5-flash": { "name": "Gemini 2.5 Flash (Free)" },
        "gpt-4o-mini": { "name": "GPT-4o Mini (Free)" },
        "o3-mini": { "name": "o3-mini (Free)" },
        "sonar-pro": { "name": "Sonar Pro (Free)" },
        "sonar-deep-research": { "name": "Sonar Deep Research (Free)" }
      }
    },
    "xiaomi-token-plan-sgp": {
      "options": {
        "baseURL": "https://token-plan-sgp.xiaomimimo.com/v1",
        "apiKey": "{env:MIMO_API_KEY}"
      }
    },
    "google": {
      "options": {
        "apiKey": "{env:GEMINI_API_KEY}"
      }
    },
    "opencode-go": {
      "name": "OpenCode Go",
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1",
        "apiKey": "{env:OPENCODE_GO_API_KEY}"
      }
    }
  },
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "question": "allow",
    "lsp": "allow",
    "skill": {
      "*": "allow"
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "local",
        "command": [
          "context7-mcp"
        ]
      },
      "playwright": {
        "type": "local",
        "command": [
          "playwright-mcp"
        ]
      },
      "sequential-thinking": {
        "type": "local",
        "command": [
          "mcp-server-sequential-thinking"
        ]
      },
      "git": {
        "type": "local",
        "command": [
          "mcp-server-git"
        ]
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      },
      "github": {
        "type": "local",
        "command": [
          "github-mcp-server",
          "stdio"
        ],
        "environment": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
        }
      },
      "codebase-memory": {
        "type": "local",
        "command": [
          "codebase-memory-mcp"
        ]
      },
      "kubernetes": {
        "type": "local",
        "command": [
          "kubernetes-mcp-server",
          "--read-only"
        ]
      },
      "terraform": {
        "type": "local",
        "command": [
          "terraform-mcp-server"
        ]
      }
    }
  }
}

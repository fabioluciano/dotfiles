java = "latest"
node = "latest"
ruby = "latest"
groovy = "latest"
python = "latest"
bun = "latest"
deno = "latest"
rust = "latest"

# Infrastructure & build utilities (float at latest)
terraform = "latest"
terragrunt = "latest"
maven = "latest"
bazel = "latest"
kubectl = "latest"
kubeconform = "latest"
terraform-ls = "latest"

# CLI tools (float at latest)
yq = "latest"
pandoc = "latest"
uv = "latest"
usage = "latest"
pre-commit = "latest"

# Node/Python tooling (moved off Homebrew so mise owns the versions)
pnpm = "latest"
"pipx:poetry" = "latest"    # pipx backend: vfox-poetry plugin is flaky
"pipx:posting" = { version = "latest", python = "3.13" }
pipx = "latest"             # note: `uv tool` / `uvx` already cover this
"npm:typescript" = "latest"
"npm:skills" = "latest"
"npm:@fission-ai/openspec" = "latest"
"npm:@andymatuschak/note-link-janitor" = { version = "latest", allow_low_downloads = true }
opencode = "latest"

# MCP servers (float at latest)
"pypi:serena-agent" = "latest"
"pipx:mcp-server-git" = "latest"
"npm:@upstash/context7-mcp" = "latest"
"npm:@playwright/mcp" = "latest"
"npm:@modelcontextprotocol/server-sequential-thinking" = "latest"
"npm:kubernetes-mcp-server" = "latest"
"pipx:headroom-ai" = { version = "latest", extras = "mcp" }
"go:github.com/hashicorp/terraform-mcp-server/cmd/terraform-mcp-server" = "latest" # Terraform — no auth tokens needed
"aqua:github/github-mcp-server" = "latest" # GitHub MCP server

# Language servers / editor tooling (float at latest)
"npm:typescript-language-server" = "latest"
"npm:vscode-langservers-extracted" = "latest"
"go:golang.org/x/tools/gopls" = "latest"
rust-analyzer = "latest"
lua-language-server = "latest"
"npm:yaml-language-server" = "latest"
"npm:bash-language-server" = "latest"
"npm:@biomejs/biome" = "latest"
"npm:basedpyright" = "latest"
"aqua:tamasfe/taplo" = "latest"
"npm:dockerfile-language-server-nodejs" = "latest"
"npm:intelephense" = "latest"
"npm:oxlint" = "latest"
"aqua:Myriad-Dreamin/tinymist" = "latest"
"aqua:astral-sh/ruff" = "latest"
"aqua:zigtools/zls" = "latest"
"aqua:elixir-lsp/elixir-ls" = "latest"
"aqua:artempyanykh/marksman" = "latest"

stylua = "latest"
"aqua:Kampfkarren/selene" = "latest"
"pipx:debugpy" = "latest"
gofumpt = "latest"
"go:golang.org/x/tools/cmd/goimports" = "latest"
golangci-lint = "latest"
"go:github.com/go-delve/delve/cmd/dlv" = "latest"
"npm:@angular/language-server" = "latest"
"npm:@vue/language-server" = "latest"
"npm:@tailwindcss/language-server" = "latest"
yamllint = "latest"
yamlfmt = "latest"
shfmt = "latest"
"npm:@microsoft/compose-language-service" = "latest"
tflint = "latest"
"npm:sql-language-server" = "latest"
helm-ls = "latest"
"npm:markdownlint-cli" = "latest"
"npm:@mdx-js/language-server" = "latest"
"npm:omniroute" = "latest"
"pipx:cmake-language-server" = "latest"
"pipx:cmakelint" = "latest"
"npm:tree-sitter-cli" = { version = "latest", npm_args = "--ignore-scripts=false" }

[settings]
# Enable version files for better compatibility
idiomatic_version_file_enable_tools = ["node", "python", "ruby", "java"]
experimental = true
verbose = false
asdf_compat = false
jobs = 4

# Bypass aube's npm trust policy (https://aube.jdx.dev/security#trust-policy)
# by shelling out to the npm CLI directly. Without this, packages whose latest
# version has weaker trust evidence than an earlier version (e.g. @mdx-js/
# language-server) cause mise install to abort with "user aborted mise add".
# This is a last-resort workaround per aube's own docs.
[settings.npm]
shell_out = true

[env]
{{- if not (has .machineName .personal_machines) }}
npm_config_registry = "https://registry.npmmirror.com"
{{- end }}

[tasks.update]
run = "mise self-update && mise upgrade"
description = "Update mise and all tools"

[tasks.update-safe]
run = "topgrade"
description = "Safe host/package-manager update path"

[tasks.update-dotfiles]
run = "chezmoi update --apply"
description = "Update dotfiles source and apply rendered changes"

[tasks.update-krew]
run = "kubectl krew upgrade"
description = "Upgrade kubectl plugins managed by Krew"

[tasks.update-nvim]
run = "nvim --headless '+Lazy! sync' +qa"
description = "Sync Neovim plugins headlessly"

[tasks.update-tmux]
run = """
if [ "$(uname)" = "Darwin" ]; then
  "$(brew --prefix tpm)/share/tpm/bin/update_plugins" all
else
  ~/.tmux/plugins/tpm/bin/update_plugins all
fi
"""
description = "Update tmux TPM plugins"

[tasks.update-full]
run = "mise run update-safe && mise run update-dotfiles && mise run update-krew && mise run update-nvim && mise run update-tmux"
description = "Full update path including dotfiles, kubectl plugins, Neovim, tmux"

[tasks.doctor-chezmoi]
run = "chezmoi doctor && chezmoi --dry-run apply"
description = "Check chezmoi integrity and pending changes"

[tasks.doctor-omp]
run = "omp --version && omp models"
description = "Verify OMP and its model catalog"

[tasks.doctor-nvim]
run = """
nvim --headless -u NONE '+lua assert(vim.fn.has("nvim-0.11") == 1)' +qa
nvim --headless '+lua
  local required = { "lazy", "astrocore", "astrolsp" }
  for _, module in ipairs(required) do assert(pcall(require, module), "missing module: " .. module) end
  local executables = { "lua-language-server", "gopls", "typescript-language-server", "sql-language-server", "stylua", "selene" }
  for _, executable in ipairs(executables) do
    if vim.fn.exepath(executable) == "" then vim.notify("missing executable: " .. executable, vim.log.levels.WARN) end
  end
  local specs = require("lazy.core.config").plugins
  for _, spec in pairs(specs) do
    local mod = spec.import or spec[1]
    if mod then
      local ok, err = pcall(require, mod)
      if not ok and not err:match("cannot find") then vim.notify("error loading " .. mod .. ": " .. err, vim.log.levels.ERROR) end
    end
  end
' +qa && echo nvim-ok
"""
description = "Headless Neovim self-check: verify binaries, plugins, and spec loading"

{{ if eq .chezmoi.os "linux" }}
[tasks.doctor-nvidia]
run = """
set -eu
command -v nvidia-smi >/dev/null || { echo "nvidia-smi ausente"; exit 1; }
nvidia-smi --query-gpu=name,driver_version --format=csv,noheader
test "$(cat /sys/module/nvidia_drm/parameters/modeset 2>/dev/null)" = "Y" || { echo "nvidia_drm.modeset != 1"; exit 1; }
grep -q 'nvidia_drm.modeset=1' /etc/kernel/cmdline 2>/dev/null || echo "aviso: nvidia_drm.modeset=1 ausente em /etc/kernel/cmdline"
grep -q 'nvidia_drm.fbdev=1' /etc/kernel/cmdline 2>/dev/null || echo "aviso: nvidia_drm.fbdev=1 ausente em /etc/kernel/cmdline"
if command -v vainfo >/dev/null; then
  vainfo 2>/dev/null | grep -q NVDEC || { echo "VA-API NVDEC indisponível"; exit 1; }
else
  echo "aviso: vainfo ausente (libva-utils)"
fi
if command -v vulkaninfo >/dev/null; then
  vulkaninfo --summary 2>/dev/null | grep -q NVIDIA || { echo "Vulkan NVIDIA indisponível"; exit 1; }
else
  echo "aviso: vulkaninfo ausente (vulkan-tools)"
fi
echo nvidia-ok
"""
description = "Verify NVIDIA driver, KMS, VA-API and Vulkan"
{{ end }}

[tasks.benchmark-nvim]
run = "startup-benchmark nvim"
description = "Measure isolated Neovim cold/warm startup, median and p95"

[tasks.benchmark-zsh]
run = "startup-benchmark zsh"
description = "Measure isolated Zsh cold/warm startup, zprof, median and p95"

[tasks.doctor-all]
run = "mise run doctor-chezmoi && mise run doctor-omp && mise run doctor-nvim"
description = "Full environment health check"

[tasks.doctor]
run = "mise doctor"
description = "Run mise doctor"

[tasks.lint]
run = "bash $(chezmoi source-path)/private_dot_local/bin/executable_dotfiles-lint --strict"
description = "Run strict non-mutating dotfiles checks"

[tasks.lint-report]
run = "bash $(chezmoi source-path)/private_dot_local/bin/executable_dotfiles-lint --report"
description = "Run all dotfiles checks without blocking on failures"


{
  "$schema": "https://raw.githubusercontent.com/cortexkit/magic-context/master/assets/magic-context.schema.json",
  "language": "pt",
  "memory": {
    "git_commit_indexing": {
      "enabled": true
    }
  },
  "embedding": {
    "provider": "local",
    "model": "Xenova/paraphrase-multilingual-MiniLM-L12-v2",
    "local_dtype": "q8"
  },
  "historian": {
    "opencode": {
      "model": "minimax-coding-plan/MiniMax-M3.1-Flash"
    },
    "omp": {
      "model": {
        "model": "openai-codex/gpt-6-luna",
        "thinking_level": "low"
      },
      "fallback_models": [
        "minimax-code/MiniMax-M3.1-Flash",
        "xiaomi-token-plan-sgp/mimo-v2.6-flash",
        "google-antigravity/gemini-3.8-flash"
      ]
    }
  },
  "dreamer": {
    "maxSteps": 12,
    "opencode": {
      "model": "minimax-coding-plan/MiniMax-M3.1-Flash"
    },
    "omp": {
      "model": {
        "model": "openai-codex/gpt-6-luna",
        "thinking_level": "low"
      },
      "fallback_models": [
        "minimax-code/MiniMax-M3.1-Flash",
        "xiaomi-token-plan-sgp/mimo-v2.6-flash",
        "google-antigravity/gemini-3.8-flash"
      ]
    }
  }
}

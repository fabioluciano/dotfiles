{{- $state := includeTemplate "opencode-state.tmpl" . | fromJson -}}
{{- $provider := $state.provider -}}
{{- $historianModels := $.opencode.historian_models | default dict -}}
{{- $historianModel := get $historianModels $provider | default "deepseek/deepseek-v4-flash" -}}
{
  "$schema": "https://raw.githubusercontent.com/cortexkit/magic-context/master/assets/magic-context.schema.json",
  "historian": {
    "model": "{{ $historianModel }}",
    "two_pass": false
  },
  "dreamer": {
    "model": "{{ $historianModel }}"
  },
  "embedding": {
    "provider": "off"
  },
  "memory": {
    "git_commit_indexing": {
      "enabled": true
    }
  }
}

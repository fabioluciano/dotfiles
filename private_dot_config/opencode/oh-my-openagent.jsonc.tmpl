{{- $state := includeTemplate "opencode-state.tmpl" . | fromJson -}}
{{- $provider := $state.provider -}}
{{- $profile := $state.profile -}}
{{- $providerModels := $state.providerModels -}}
{{- /* "moderate" is an alias for "optimized" — they share the same variants */ -}}
{{- if eq $profile "moderate" -}}{{- $profile = "optimized" -}}{{- end -}}
{{- $variantProvider := $provider -}}
{{- $variantKey := printf "%s-%s" $variantProvider $profile -}}
{{- $providerVariants := ternary (get $.opencode.variants $variantKey) (get $.opencode.variants $variantProvider | default dict) (hasKey $.opencode.variants $variantKey) -}}
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "tui": {
    "sidebar": {
      "enabled": false
    }
  },
  "team_mode": {
    "enabled": true,
    "max_parallel_members": 3,
    "max_members": 6,
    "tmux_visualization": true,
    "max_wall_clock_minutes": 45,
    "max_messages_per_run": 10000,
    "max_member_turns": 500,
    "message_payload_max_bytes": 32768,
    "recipient_unread_max_bytes": 262144,
    "mailbox_poll_interval_ms": 3000
  },
  "agents": {
{{- $agents := keys $.opencode.agent_profiles | sortAlpha }}
{{- range $i, $agent := $agents }}
{{- $profile := index $.opencode.agent_profiles $agent }}
{{- $chain := index $providerModels $profile | default (index $providerModels "standard") | default (index $providerModels "orchestrator") }}
{{- $primary := first $chain }}
{{- $variantValue := get $providerVariants $profile }}
    "{{ $agent }}": {
      "model": "{{ $primary }}",
      "fallback_models": [{{ range $j, $m := rest $chain }}{{ if $j }}, {{ end }}{"model": "{{ $m }}"}{{ end }}]
{{- if $variantValue }}
      ,"variant": "{{ $variantValue }}"
{{- end }}
      ,"prompt_append": "file://~/.config/opencode/AGENTS.md"
{{- $ultraworkProfile := get $.opencode.agent_ultrawork_profiles $agent }}
{{- if $ultraworkProfile }}
{{- $ultraworkChain := index $providerModels $ultraworkProfile | default (index $providerModels "standard") | default (index $providerModels "orchestrator") }}
{{- $ultraworkVariant := get $providerVariants $ultraworkProfile }}
      ,"ultrawork": {
        "model": "{{ first $ultraworkChain }}"{{ if $ultraworkVariant }},
        "variant": "{{ $ultraworkVariant }}"{{ end }}
      }
{{- end }}
{{- if or (eq $agent "explore") (eq $agent "librarian") (eq $agent "multimodal-looker") }}
      ,"permission": {
        "edit": "deny"{{ if eq $agent "explore" }},
        "bash": "ask"{{ end }}
      }
{{- end }}
    }{{ if lt $i (sub (len $agents) 1) }},{{ end }}
{{- end }}
  },
  "categories": {
{{- $categories := keys $.opencode.category_profiles | sortAlpha }}
{{- range $i, $cat := $categories }}
{{- $profile := index $.opencode.category_profiles $cat }}
{{- $chain := index $providerModels $profile | default (index $providerModels "standard") | default (index $providerModels "orchestrator") }}
{{- $primary := first $chain }}
{{- $variantValue := get $providerVariants $profile }}
    "{{ $cat }}": {
      "model": "{{ $primary }}",
      "fallback_models": [{{ range $j, $m := rest $chain }}{{ if $j }}, {{ end }}{"model": "{{ $m }}"}{{ end }}]
{{- if $variantValue }}
      ,"variant": "{{ $variantValue }}"
{{- end }}
      ,"prompt_append": "file://~/.config/opencode/AGENTS.md"
    }{{ if lt $i (sub (len $categories) 1) }},{{ end }}
{{- end }}
  },
  "sisyphus_agent": {
    "planner_enabled": true,
    "replace_plan": false,
    "default_builder_enabled": true
  },
  "agent_order": [
    "sisyphus",
    "atlas",
    "hephaestus",
    "oracle",
    "prometheus",
    "metis",
    "momus",
    "librarian",
    "explore",
    "multimodal-looker",
    "sisyphus-junior"
  ],
  "experimental": {
    "disable_omo_env": true,
    "task_system": true
  },
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [429, 500, 502, 503, 504],
    "max_fallback_attempts": 3,
    "cooldown_seconds": 60,
    "notify_on_fallback": true
  },
  "notification": {
    "force_enable": true
  },
  // Disable CodeGraph MCP — injected by oh-my-openagent; codebase-memory is used instead
  "codegraph": {
    "enabled": false,
    "auto_init": true,
    "auto_provision": true
  },
  "git_master": {
    "commit_footer": true,
    "include_co_authored_by": true,
    "git_env_prefix": "GIT_MASTER=1"
  }
}

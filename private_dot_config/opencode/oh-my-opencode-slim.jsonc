{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@3.0.6/oh-my-opencode-slim.schema.json",
  "autoUpdate": false,
  // Model roles and fallback order mirror the managed OMP configuration.
  //
  // Two tiers:
  //   - reasoners (orchestrator, oracle, designer, council) start on the
  //     strongest models and walk down only as models fail or run out.
  //   - cheap lanes (explorer, fixer, observer) start on the free/cheap tier
  //     and keep a strong model at the end of the chain as the last resort.
  "disabled_agents": [],
  "backgroundJobs": {
    "concurrency": {
    }
  },
  "fallback": {
    "enabled": true,
    "maxRetries": 0,
    "initialRetryDelayMs": 0,
    "retryDelayMs": 0,
    "continuationPolicy": "stick-to-fallback"
  },
  "agents": {
    "orchestrator": {
      "model": [
        "google/antigravity-claude-sonnet-4-6",
        "openai/gpt-6.1-terra",
        "openai-codex/gpt-6.1-terra",
        "anthropic/claude-sonnet-5-5",
        "opencode-go/deepseek-v4-pro",
        "opencode-go/minimax-m3",
        "minimax-coding-plan/MiniMax-M3.1-Flash",
        "xiaomi-token-plan-sgp/mimo-v2.6-pro"
      ],
      "skills": ["*"]
    },
    "oracle": {
      "model": [
        "google/antigravity-claude-sonnet-4-6",
        "openai/gpt-6.1-terra",
        "openai-codex/gpt-6.1-terra",
        "anthropic/claude-sonnet-5-5",
        "opencode-go/deepseek-v4-pro",
        "opencode-go/minimax-m3",
        "minimax-coding-plan/MiniMax-M3.1-Flash",
        "xiaomi-token-plan-sgp/mimo-v2.6-pro"
      ],
      "mcps": ["*"]
    },
    "council": {
      "model": [
        "google/antigravity-claude-sonnet-4-6",
        "openai/gpt-6.1-terra",
        "openai-codex/gpt-6.1-terra",
        "anthropic/claude-sonnet-5-5",
        "opencode-go/deepseek-v4-pro",
        "opencode-go/minimax-m3",
        "minimax-coding-plan/MiniMax-M3.1-Flash",
        "xiaomi-token-plan-sgp/mimo-v2.6-pro"
      ],
      "mcps": ["*"]
    },
    "designer": {
      "model": [
        "google/antigravity-claude-sonnet-4-6",
        "openai/gpt-6.1-terra",
        "openai-codex/gpt-6.1-terra",
        "anthropic/claude-sonnet-5-5",
        "opencode-go/deepseek-v4-pro",
        "opencode-go/minimax-m3",
        "minimax-coding-plan/MiniMax-M3.1-Flash",
        "xiaomi-token-plan-sgp/mimo-v2.6-pro"
      ],
      "mcps": ["*"]
    },
    "explorer": {
      "model": [
        "anthropic/claude-haiku-5-5",
        "openai/gpt-6-luna",
        "openai-codex/gpt-6-luna",
        "opencode-go/minimax-m3.1-flash",
        "minimax-coding-plan/MiniMax-M3.1-Flash",
        "google/antigravity-gemini-3.8-flash-high",
        "xiaomi-token-plan-sgp/mimo-v2.6-flash"
      ],
      "mcps": ["*"]
    },
    "fixer": {
      "model": [
        "anthropic/claude-haiku-5-5",
        "openai/gpt-6-luna",
        "openai-codex/gpt-6-luna",
        "opencode-go/minimax-m3.1-flash",
        "minimax-coding-plan/MiniMax-M3.1-Flash",
        "google/antigravity-gemini-3.8-flash-high",
        "xiaomi-token-plan-sgp/mimo-v2.6-flash"
      ],
      "mcps": ["*"]
    },
    "observer": {
      "model": [
        "anthropic/claude-haiku-5-5",
        "openai/gpt-6-luna",
        "openai-codex/gpt-6-luna",
        "opencode-go/minimax-m3.1-flash",
        "minimax-coding-plan/MiniMax-M3.1-Flash",
        "google/antigravity-gemini-3.8-flash-high",
        "xiaomi-token-plan-sgp/mimo-v2.6-flash"
      ],
      "mcps": ["*"]
    }
  }
}

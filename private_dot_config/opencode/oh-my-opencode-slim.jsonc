{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@3.0.6/oh-my-opencode-slim.schema.json",
  "autoUpdate": false,
  // Model roles and fallback order mirror the managed OMP configuration.
  "disabled_agents": [],
  "backgroundJobs": {
    "concurrency": {
      "providerConcurrency": { "xiaomi-token-plan-sgp": 2 }
    }
  },
  "agents": {
    "orchestrator": {
      "model": [
        "opencode-go/deepseek-v4.1-flash",
        "openai/gpt-6-luna",
        "google/antigravity-gemini-3.8-flash-medium",
        "xiaomi-token-plan-sgp/mimo-v2.6-flash"
      ],
      "skills": ["*"]
    },
    "oracle": {
      "model": [
        "openai/gpt-6.1-sol",
        "opencode-go/deepseek-v4.1-flash",
        "google/antigravity-gemini-3.8-flash-medium",
        "xiaomi-token-plan-sgp/mimo-v2.6-flash"
      ]
    },
    "explorer": {
      "model": [
        { "id": "openai/gpt-6-luna", "variant": "low" },
        "opencode-go/deepseek-v4.1-flash",
        "google/antigravity-gemini-3.8-flash-medium",
        "xiaomi-token-plan-sgp/mimo-v2.6-flash"
      ]
    },
    "designer": {
      "model": [
        "google/antigravity-claude-sonnet-4-6",
        "opencode-go/deepseek-v4.1-flash",
        "google/antigravity-gemini-3.8-flash-medium",
        "openai/gpt-6.1-sol",
        "xiaomi-token-plan-sgp/mimo-v2.6-pro"
      ]
    },
    "fixer": {
      "model": [
        "opencode-go/deepseek-v4.1-flash",
        "openai/gpt-6-luna",
        "google/antigravity-gemini-3.8-flash-medium",
        "xiaomi-token-plan-sgp/mimo-v2.6-flash"
      ]
    },
    "observer": {
      "model": [
        "google/antigravity-gemini-3.8-flash-medium",
        "openai/gpt-6-luna",
        "google/antigravity-claude-sonnet-4-6",
        "xiaomi-token-plan-sgp/mimo-v2.6-flash"
      ]
    },
    "council": {
      "model": [
        "openai/gpt-6-luna",
        "google/antigravity-gemini-3.8-flash-medium",
        "xiaomi-token-plan-sgp/mimo-v2.6-flash"
      ]
    }
  }
}

{{- /* ── State reading (shared template) ── */ -}}
{{- $state := includeTemplate "opencode-state.tmpl" . | fromJson -}}
{{- $provider := $state.provider -}}
{{- $profile := $state.profile -}}
{{- $providerModels := $state.providerModels -}}
{{- $validProviders := keys $.providers -}}
{{- /* zen-free maps to the opencode-zen-free preset (tuned static config) */ -}}
{{- $presetName := ternary "opencode-zen-free" $provider (eq $provider "zen-free") -}}

{{- /* ── Agent → tier mapping (mirrors providers.toml tiers) ── */ -}}
{{- $agentTiers := list
  (dict "name" "orchestrator" "tier" "orchestrator")
  (dict "name" "oracle"       "tier" "architecture")
  (dict "name" "librarian"    "tier" "search")
  (dict "name" "explorer"     "tier" "search")
  (dict "name" "designer"     "tier" "visual")
  (dict "name" "fixer"        "tier" "implementation")
  (dict "name" "observer"     "tier" "vision")
  (dict "name" "council"      "tier" "orchestrator")
-}}
{{- $agentSkills := dict
  "orchestrator" (list "*")
  "oracle"       (list "simplify")
  "librarian"    (list)
  "explorer"     (list)
  "designer"     (list)
  "fixer"        (list)
  "observer"     (list)
  "council"      (list)
-}}
{{- $agentMcps := dict
  "orchestrator" (list "github" "kubernetes" "terraform" "sequential-thinking" "git")
  "oracle"       (list "codebase-memory" "sequential-thinking" "git")
  "librarian"    (list "websearch" "context7" "gh_grep" "sequential-thinking" "git")
  "explorer"     (list "codebase-memory" "sequential-thinking" "git")
  "designer"     (list "playwright" "sequential-thinking" "git")
  "fixer"        (list "sequential-thinking" "git")
  "observer"     (list "playwright" "sequential-thinking" "git")
  "council"      (list "sequential-thinking" "git")
-}}
{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json",
  "preset": "{{ $presetName }}",
  "presets": {
    "opencode-zen-free": {
      "orchestrator": {
        "model": "opencode/hy3-free",
        "temperature": 0.4,
        "skills": ["*"],
        "mcps": ["github", "kubernetes", "terraform", "sequential-thinking", "git"]
      },
      "oracle": {
        "model": "opencode/big-pickle",
        "temperature": 0.4,
        "variant": "max",
        "skills": ["simplify"],
        "mcps": ["codebase-memory", "sequential-thinking", "git"]
      },
      "librarian": {
        "model": "opencode/deepseek-v4-flash-free",
        "temperature": 0.2,
        "skills": [],
        "mcps": ["websearch", "context7", "gh_grep", "sequential-thinking", "git"]
      },
      "explorer": {
        "model": "opencode/north-mini-code-free",
        "temperature": 0.2,
        "skills": [],
        "mcps": ["codebase-memory", "sequential-thinking", "git"]
      },
      "designer": {
        "model": "opencode/mimo-v2.5-free",
        "temperature": 0.3,
        "variant": "medium",
        "skills": [],
        "mcps": ["playwright", "sequential-thinking", "git"]
      },
      "fixer": {
        "model": "opencode/deepseek-v4-flash-free",
        "temperature": 0.2,
        "variant": "high",
        "skills": [],
        "mcps": ["sequential-thinking", "git"]
      },
      "observer": {
        "model": "opencode/mimo-v2.5-free",
        "temperature": 0.2,
        "variant": "low",
        "skills": [],
        "mcps": ["playwright", "sequential-thinking", "git"]
      },
      "council": {
        "model": "opencode/hy3-free",
        "temperature": 0.4,
        "skills": [],
        "mcps": ["sequential-thinking", "git"]
      }
    }
{{- $sortedProviders := sortAlpha $validProviders -}}
{{- range $prov := $sortedProviders }}
{{- if ne $prov "zen-free" }}
{{- $profileModelKey := printf "%s-%s" $prov $profile -}}
{{- $models := index $.opencode.models $profileModelKey | default (index $.opencode.models $prov) -}}
{{- $modelOverrides := get (get $.opencode "omos_overrides" | default dict) $prov | default dict -}}
    ,"{{ $prov }}": {
{{- range $ai, $agent := $agentTiers }}
{{- $agentName := index $agent "name" -}}
{{- $tier := index $agent "tier" -}}
{{- $chain := index $models $tier | default (index $models "standard") | default (index $models "orchestrator") -}}
{{- $model := get $modelOverrides $agentName | default (first $chain) -}}
      "{{ $agentName }}": {
        "model": "{{ $model }}",
        "skills": {{ toJson (index $agentSkills $agentName) }},
        "mcps": {{ toJson (index $agentMcps $agentName) }}
      }{{ if lt $ai (sub (len $agentTiers) 1) }},{{ end }}
{{- end }}
    }
{{- end }}
{{- end }}
  },
  "council": {
    "default_preset": "default",
    "presets": {
      "default": {
        "alpha": {
          "model": "{{ first (index $providerModels "architecture") }}"
        }
      }
    }
  }
}

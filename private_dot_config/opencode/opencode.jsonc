{
  "$schema": "https://opencode.ai/config.json",
  "model": "minimax-coding-plan/MiniMax-M3.1-Flash",
  "agents": {
    "plan": {
      "model": "google/antigravity-claude-sonnet-4-6"
    }
  },
  "mcp": {
    "servers": {
      "serena": {
        "type": "local",
        "command": [
          "serena",
          "start-mcp-server",
          "--context",
          "ide",
          "--project-from-cwd",
          "--open-web-dashboard",
          "false"
        ],
        "timeout": {
          "startup": 60000,
          "catalog": 60000
        }
      },
      "context7": {
        "type": "local",
        "command": [
          "context7-mcp"
        ],
        "timeout": {
          "startup": 8000,
          "catalog": 8000
        }
      },
      "sequential-thinking": {
        "type": "local",
        "command": [
          "mcp-server-sequential-thinking"
        ],
        "timeout": {
          "startup": 10000,
          "catalog": 10000
        }
      },
      "git": {
        "type": "local",
        "command": [
          "mcp-server-git"
        ],
        "timeout": {
          "startup": 10000,
          "catalog": 10000
        }
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app",
        "timeout": {
          "startup": 8000,
          "catalog": 8000
        }
      },
      "kubernetes": {
        "type": "local",
        "command": [
          "kubernetes-mcp-readonly"
        ],
        "timeout": {
          "startup": 15000,
          "catalog": 15000
        }
      },
      "terraform": {
        "type": "local",
        "command": [
          "terraform-mcp-server"
        ],
        "timeout": {
          "startup": 10000,
          "catalog": 10000
        }
      },
      "playwright": {
        "type": "local",
        "command": [
          "playwright-mcp"
        ],
        "timeout": {
          "startup": 15000,
          "catalog": 15000
        }
      },
      "github": {
        "type": "local",
        "command": [
          "github-mcp-server",
          "stdio"
        ],
        "timeout": {
          "startup": 15000,
          "catalog": 15000
        }
      },
      "codebase-memory": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "codebase-memory-mcp"
        ]
      },
      "context-mode": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "context-mode"
        ]
      }
    }
  },
  "lsp": {
    "marksman": {
      "command": [
        "marksman",
        "server"
      ],
      "extensions": [
        ".md",
        ".markdown"
      ]
    },
    "helm-ls": {
      "command": [
        "helm_ls",
        "serve"
      ],
      "extensions": [
        ".yaml",
        ".yml"
      ]
    },
    "tailwindcss-language-server": {
      "command": [
        "tailwindcss-language-server",
        "--stdio"
      ],
      "extensions": [
        ".html",
        ".css",
        ".js",
        ".jsx",
        ".ts",
        ".tsx",
        ".vue",
        ".svelte"
      ]
    },
    "angular-language-server": {
      "command": [
        "omp-ngserver",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".html"
      ]
    },
    // basedpyright no lugar do built-in "pyright" (o shim pyright do basedpyright duplicaria diagnósticos).
    "pyright": {
      "disabled": true
    },
    "basedpyright": {
      "command": [
        "basedpyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    },
    "taplo": {
      "command": [
        "taplo",
        "lsp",
        "stdio"
      ],
      "extensions": [
        ".toml"
      ]
    },
    "cmake-language-server": {
      "command": [
        "cmake-language-server"
      ],
      "extensions": [
        "CMakeLists.txt",
        ".cmake"
      ]
    },
    "docker-compose-langserver": {
      "command": [
        "docker-compose-langserver",
        "--stdio"
      ],
      "extensions": [
        "docker-compose.yml",
        "docker-compose.yaml",
        "compose.yml",
        "compose.yaml"
      ]
    },
    "vscode-css-language-server": {
      "command": [
        "vscode-css-language-server",
        "--stdio"
      ],
      "extensions": [
        ".css",
        ".scss",
        ".less"
      ]
    },
    "vscode-html-language-server": {
      "command": [
        "vscode-html-language-server",
        "--stdio"
      ],
      "extensions": [
        ".html",
        ".htm"
      ]
    },
    "vscode-json-language-server": {
      "command": [
        "vscode-json-language-server",
        "--stdio"
      ],
      "extensions": [
        ".json",
        ".jsonc"
      ]
    },
    "ruff": {
      "command": [
        "ruff",
        "server"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    }
  },
  "plugins": [
    "@upstash/context7-opencode@latest",
    "opencode-antigravity-auth@latest",
    "@slkiser/opencode-quota@latest",
    "@plannotator/opencode@latest",
    "opencode-beads@latest",
    "oh-my-opencode-slim@latest",
    "@mohak34/opencode-notifier@latest",
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@cortexkit/opencode-magic-context@latest",
    "opencode-claude-auth@latest"
  ],
  "instructions": [
    "~/.config/opencode/plugin-workflow.md"
  ],
  "formatter": true,
  "compaction": {
    "auto": false
  },
  "provider": {
    // Detected anthropic authentication; opencode-quota added this global provider declaration.
    "anthropic": {},
    // Detected openai authentication; opencode-quota added this global provider declaration.
    "openai": {},
    // Detected minimax-coding-plan authentication; opencode-quota added this global provider declaration.
    "minimax-coding-plan": {},
    // Detected opencode authentication; opencode-quota added this global provider declaration.
    "opencode": {}
  }
}

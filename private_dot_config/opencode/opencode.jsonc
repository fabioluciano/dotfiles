{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "agents": {
    "plan": { "model": "google/antigravity-claude-sonnet-4-6" }
  },
  "mcp": {
    "servers": {
      "serena": {
        "type": "local",
        "command": ["serena", "start-mcp-server", "--context", "ide", "--project-from-cwd", "--open-web-dashboard", "false"],
        "timeout": { "startup": 60000, "catalog": 60000 }
      },
      "context7": {
        "type": "local",
        "command": ["context7-mcp"],
        "timeout": { "startup": 8000, "catalog": 8000 }
      },
      "sequential-thinking": {
        "type": "local",
        "command": ["mcp-server-sequential-thinking"],
        "timeout": { "startup": 10000, "catalog": 10000 }
      },
      "git": {
        "type": "local",
        "command": ["mcp-server-git"],
        "timeout": { "startup": 10000, "catalog": 10000 }
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app",
        "timeout": { "startup": 8000, "catalog": 8000 }
      },
      "kubernetes": {
        "type": "local",
        "command": ["kubernetes-mcp-server", "--read-only"],
        "timeout": { "startup": 15000, "catalog": 15000 }
      },
      "terraform": {
        "type": "local",
        "command": ["terraform-mcp-server"],
        "timeout": { "startup": 10000, "catalog": 10000 }
      },
      "playwright": {
        "type": "local",
        "command": ["playwright-mcp"],
        "timeout": { "startup": 15000, "catalog": 15000 }
      },
      "github": {
        "type": "local",
        "command": ["github-mcp-server", "stdio"],
        "timeout": { "startup": 15000, "catalog": 15000 }
      }
    }
  },
  "lsp": {
    "marksman": { "command": ["marksman", "server"], "extensions": [".md", ".markdown"] },
    "yaml-language-server": { "command": ["yaml-language-server", "--stdio"], "extensions": [".yaml", ".yml"] },
    "dockerfile-language-server": { "command": ["docker-langserver", "--stdio"], "extensions": [".dockerfile"] },
    "helm-ls": { "command": ["helm_ls", "serve"], "extensions": [".yaml", ".yml"] },
    "tailwindcss-language-server": { "command": ["tailwindcss-language-server", "--stdio"], "extensions": [".html", ".css", ".js", ".jsx", ".ts", ".tsx", ".vue", ".svelte"] },
    "vue-language-server": { "command": ["vue-language-server", "--stdio"], "extensions": [".vue"] },
    "angular-language-server": { "command": ["omp-ngserver", "--stdio"], "extensions": [".ts", ".tsx", ".html"] },
    "zls": { "command": ["zls"], "extensions": [".zig", ".zon"] },
    "tinymist": { "command": ["tinymist", "lsp"], "extensions": [".typ"] },
    "basedpyright": { "command": ["basedpyright-langserver", "--stdio"], "extensions": [".py", ".pyi"] },
    "jdtls": { "command": ["jdtls"], "extensions": [".java", ".groovy"] },
    "taplo": { "command": ["taplo", "lsp", "stdio"], "extensions": [".toml"] },
    "sql-language-server": { "command": ["sql-language-server", "up", "--method", "stdio"], "extensions": [".sql"] },
    "cmake-language-server": { "command": ["cmake-language-server"], "extensions": ["CMakeLists.txt", ".cmake"] },
    "mdx-language-server": { "command": ["mdx-language-server", "--stdio"], "extensions": [".mdx"] },
    "docker-compose-langserver": { "command": ["docker-compose-langserver", "--stdio"], "extensions": ["docker-compose.yml", "docker-compose.yaml", "compose.yml", "compose.yaml"] },
    "terraform-ls": { "command": ["terraform-ls", "serve"], "extensions": [".tf", ".tfvars"] },
    "vscode-css-language-server": { "command": ["vscode-css-language-server", "--stdio"], "extensions": [".css", ".scss", ".less"] },
    "vscode-html-language-server": { "command": ["vscode-html-language-server", "--stdio"], "extensions": [".html", ".htm"] },
    "vscode-json-language-server": { "command": ["vscode-json-language-server", "--stdio"], "extensions": [".json", ".jsonc"] },
    "vscode-eslint-language-server": { "command": ["vscode-eslint-language-server", "--stdio"], "extensions": [".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs"] },
    "biome": { "command": ["biome", "lsp-proxy"], "extensions": [".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs", ".json", ".jsonc", ".css", ".scss"] },
    "oxlint": { "command": ["oxlint", "--lsp"], "extensions": [".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs"] },
    "gopls": { "command": ["gopls"], "extensions": [".go"] },
    "rust-analyzer": { "command": ["rust-analyzer"], "extensions": [".rs"] },
    "lua-language-server": { "command": ["lua-language-server"], "extensions": [".lua"] },
    "bash-language-server": { "command": ["bash-language-server", "start"], "extensions": [".sh", ".bash", ".zsh"] },
    "typescript-language-server": { "command": ["typescript-language-server", "--stdio"], "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs"] },
    "elixir-ls": { "command": ["elixir-ls"], "extensions": [".ex", ".exs"] },
    "intelephense": { "command": ["intelephense", "--stdio"], "extensions": [".php"] },
    "ruff": { "command": ["ruff", "server"], "extensions": [".py", ".pyi"] }
  },
  "plugins": [
    "@upstash/context7-opencode@0.2.1",
    "opencode-antigravity-auth@2.1.2",
    "@slkiser/opencode-quota@6.0.0",
    "@plannotator/opencode@0.28.33",
    "opencode-beads@0.9.0",
    "oh-my-opencode-slim@3.0.6",
    "@mohak34/opencode-notifier@1.1.1",
    "superpowers@git+https://github.com/obra/superpowers.git#v7.0.1"
  ],
  "instructions": ["~/.config/opencode/plugin-workflow.md"]
}

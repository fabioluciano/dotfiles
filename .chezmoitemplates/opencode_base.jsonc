{{- $state := includeTemplate "opencode-state.tmpl" . | fromJson -}}
{{- $provider := $state.provider -}}
{{- $profile := $state.profile -}}
{{- $providerModels := $state.providerModels -}}
{{- /* enabled_providers precisa dos namespaces NATIVOS do opencode (registry
      [providers.<key>].opencode_id), não das keys estáveis da matriz. */ -}}
{{- $enabledProviders := list -}}
{{- range $pkey := without (sortAlpha (keys $.opencode.models)) "zen-free" -}}
{{- $enabledProviders = append $enabledProviders (get (index $.providers $pkey) "opencode_id" | default $pkey) -}}
{{- end -}}
  "$schema": "https://opencode.ai/config.json",
  // NOTE: The effective model is normally controlled by oh-my-openagent or
  // oh-my-opencode-slim (rendered from opencode_providers.toml). This field is
  // only used when those agent plugins are disabled.
  "model": "{{ first (index $providerModels "orchestrator") }}",
  "small_model": "{{ first (index $providerModels "quick") }}",
  "default_agent": "build",
  "agent": {
    "build": {
      "model": "{{ first (index $providerModels "implementation") }}"
    },
    "plan": {
      "model": "{{ first (index $providerModels "planner") }}"
    }{{- /* OMO agents: the OMO 4.x plugin has a hardcoded requiresProvider
        whitelist that drops agents whose active provider isn't in
        [openai, github-copilot, opencode, vercel, ...]. The TUI then
        displays the fallbackChain[0] (typically openai/gpt-5.6-sol) for
        the dropped agent. To force the TUI to show the user-configured
        model for the active provider, we explicitly add per-agent model
        overrides here — the opencode binary's TUI renderer picks these
        up and displays them. The OMO plugin still uses AGENT_MODEL_REQUIREMENTS
        for runtime resolution (with the same whitelist), but the
        bypass via hasHephaestusExplicitConfig from oh-my-openagent.jsonc
        keeps the actual model correct. */ -}}
{{- range $agent, $tier := $.opencode.agent_profiles }}
{{- $tierModels := index $providerModels $tier -}}
{{- $stdModels := index $providerModels "standard" -}}
{{- $orchModels := index $providerModels "orchestrator" -}}
{{- $chain := or $tierModels $stdModels $orchModels }}
    ,"{{ $agent }}": {
      "model": "{{ first $chain }}"
    }
{{- end }}
  },
  "formatter": true,
  "lsp": {
    "marksman": {
      "command": [
        "marksman",
        "server"
      ],
      "extensions": [
        ".md",
        ".markdown"
      ]
    },
    "yaml-language-server": {
      "command": [
        "yaml-language-server",
        "--stdio"
      ],
      "extensions": [
        ".yaml",
        ".yml"
      ]
    },
    "dockerfile-language-server": {
      "command": [
        "docker-langserver",
        "--stdio"
      ],
      "extensions": [
        ".dockerfile"
      ]
    },
    "helm-ls": {
      "command": [
        "helm_ls",
        "serve"
      ],
      "extensions": [
        ".yaml",
        ".yml"
      ]
    },
    "tailwindcss-language-server": {
      "command": [
        "tailwindcss-language-server",
        "--stdio"
      ],
      "extensions": [
        ".html",
        ".css",
        ".js",
        ".jsx",
        ".ts",
        ".tsx",
        ".vue",
        ".svelte"
      ]
    },
    "vue-language-server": {
      "command": [
        "vue-language-server",
        "--stdio"
      ],
      "extensions": [
        ".vue"
      ]
    },
    "zls": {
      "command": [
        "zls"
      ],
      "extensions": [
        ".zig",
        ".zon"
      ]
    },
    "tinymist": {
      "command": [
        "tinymist",
        "lsp"
      ],
      "extensions": [
        ".typ"
      ]
    },
    "pyright": {
      "disabled": true
    },
    "basedpyright": {
      "command": [
        "uvx",
        "--from",
        "basedpyright",
        "basedpyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    },
    "jdtls": {
      "command": [
        "jdtls"
      ],
      "extensions": [
        ".java",
        ".groovy"
      ]
    },
    "taplo": {
      "command": [
        "taplo",
        "lsp",
        "stdio"
      ],
      "extensions": [
        ".toml"
      ]
    },
    "sql-language-server": {
      "command": [
        "sql-language-server",
        "up",
        "--method",
        "stdio"
      ],
      "extensions": [
        ".sql"
      ]
    },
    "cmake-language-server": {
      "command": [
        "cmake-language-server"
      ],
      "extensions": [
        "CMakeLists.txt",
        ".cmake"
      ]
    },
    "mdx-language-server": {
      "command": [
        "mdx-language-server",
        "--stdio"
      ],
      "extensions": [
        ".mdx"
      ]
    },
    "docker-compose-langserver": {
      "command": [
        "docker-compose-langserver",
        "--stdio"
      ],
      "extensions": [
        "docker-compose.yml",
        "docker-compose.yaml",
        "compose.yml",
        "compose.yaml"
      ]
    },
    "vscode-css-language-server": {
      "command": [
        "vscode-css-language-server",
        "--stdio"
      ],
      "extensions": [
        ".css",
        ".scss",
        ".less"
      ]
    },
    "vscode-html-language-server": {
      "command": [
        "vscode-html-language-server",
        "--stdio"
      ],
      "extensions": [
        ".html",
        ".htm"
      ]
    },
    "vscode-json-language-server": {
      "command": [
        "vscode-json-language-server",
        "--stdio"
      ],
      "extensions": [
        ".json",
        ".jsonc"
      ]
    },
    "vscode-eslint-language-server": {
      "command": [
        "vscode-eslint-language-server",
        "--stdio"
      ],
      "extensions": [
        ".js",
        ".jsx",
        ".ts",
        ".tsx",
        ".mjs",
        ".cjs"
      ]
    },
    "gopls": {
      "command": [
        "gopls"
      ],
      "extensions": [
        ".go"
      ]
    },
    "rust-analyzer": {
      "command": [
        "rust-analyzer"
      ],
      "extensions": [
        ".rs"
      ]
    },
    "lua-language-server": {
      "command": [
        "lua-language-server"
      ],
      "extensions": [
        ".lua"
      ]
    },
    "bash-language-server": {
      "command": [
        "bash-language-server",
        "start"
      ],
      "extensions": [
        ".sh",
        ".bash",
        ".zsh"
      ]
    },
    "typescript-language-server": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs"
      ]
    },
    "elixir-ls": {
      "command": [
        "elixir-ls"
      ],
      "extensions": [
        ".ex",
        ".exs"
      ]
    },
    "intelephense": {
      "command": [
        "intelephense",
        "--stdio"
      ],
      "extensions": [
        ".php"
      ]
    },
    "ruff": {
      "command": [
        "ruff",
        "server"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    }
  },
  "enabled_providers": {{ toJson $enabledProviders }},
  "compaction": {
    "auto": false,
    "prune": false,
    "reserved": 6000
  },
  "watcher": {
    "ignore": [
      ".git",
      "node_modules",
      "dist",
      "build",
      ".next",
      ".nuxt",
      ".output",
      ".cache",
      "coverage",
      "*.log",
      ".turbo",
      ".venv",
      "__pycache__",
      "target"
    ]
  },
  "instructions": [
    "~/.config/opencode/AGENTS.md"
  ],
  "provider": {
    // Catálogo de modelos vem do models.dev (auto-atualizado pelo opencode);
    // sem bloco "models" local. Só sobrescrevemos auth/endpoint quando o env
    // var difere do que o models.dev espera.
    "xiaomi-token-plan-sgp": {
      "options": {
        "baseURL": "https://token-plan-sgp.xiaomimimo.com/v1",
        "apiKey": "{env:MIMO_API_KEY}"
      }
    },
    "openai": {
      "options": {}
    },
    "google": {
      "options": {
        "apiKey": "{env:GEMINI_API_KEY}"
      }
    },
    "opencode": {
      "options": {
        "apiKey": "{env:OPENCODE_API_KEY}"
      }
    },
    "minimax": {
      "npm": "@ai-sdk/anthropic",
      "name": "MiniMax",
      "options": {
        "baseURL": "https://api.minimax.io/anthropic/v1",
        "apiKey": "{env:MINIMAX_API_KEY}"
      }
    },
    "deepseek": {
      "options": {
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      }
    },
    "kimi-for-coding": {
      "options": {
        "baseURL": "https://api.kimi.com/coding/v1",
        "apiKey": "{env:KIMI_CODE_API_KEY}"
      }
    },
    "zai-coding-plan": {
      "options": {
        "baseURL": "https://api.z.ai/api/coding/paas/v4",
        "apiKey": "{env:ZAI_API_KEY}"
      }
    },
    // Built-in alibaba-token-plan provider (npm, baseURL e modelos
    // vêm do models.dev). Aqui só sobrescrevemos a apiKey para apontar
    // para o env var já existente (QWENCLOUD_API_TOKEN) em vez do nome
    // padrão ALIBABA_TOKEN_PLAN_API_KEY, evitando renomear o item do
    // Bitwarden e o zsh-tokens-sync.
    "alibaba-token-plan": {
      "options": {
        "apiKey": "{env:QWENCLOUD_API_TOKEN}"
      }
    },
    "commandcode-anthropic": {
      "npm": "@ai-sdk/anthropic",
      "name": "Command Code (Anthropic)",
      "options": {
        "baseURL": "https://api.commandcode.ai/provider/v1",
        "apiKey": "{env:COMMANDCODE_API_KEY}"
      }
    },
    "commandcode": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Command Code",
      "options": {
        "baseURL": "https://api.commandcode.ai/provider/v1",
        "apiKey": "{env:COMMANDCODE_API_KEY}"
      },
      "models": {
        "claude-opus-5": {
          "name": "Claude Opus 5"
        },
        "claude-opus-4-8": {
          "name": "Claude Opus 4.8"
        },
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6"
        },
        "claude-haiku-4-5-20251001": {
          "name": "Claude Haiku 4.5"
        },
        "gpt-5.6-terra": {
          "name": "GPT 5.6 Terra"
        },
        "gpt-5.6-sol": {
          "name": "GPT 5.6 Sol"
        },
        "gpt-5.6-luna": {
          "name": "GPT 5.6 Luna"
        },
        "gpt-5.5": {
          "name": "GPT 5.5"
        },
        "gpt-5.4-mini": {
          "name": "GPT 5.4 Mini"
        },
        "deepseek/deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        },
        "deepseek/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "moonshotai/Kimi-K3": {
          "name": "Kimi K3"
        },
        "moonshotai/Kimi-K2.7-Code": {
          "name": "Kimi K2.7 Code"
        },
        "zai-org/GLM-5.3": {
          "name": "GLM 5.3"
        },
        "zai-org/GLM-5.2-Fast": {
          "name": "GLM 5.2 Fast"
        },
        "MiniMaxAI/MiniMax-M3": {
          "name": "MiniMax M3"
        },
        "MiniMaxAI/MiniMax-M2.5": {
          "name": "MiniMax M2.5"
        },
        "google/gemini-3.7-flash": {
          "name": "Gemini 3.7 Flash"
        },
        "Qwen/Qwen3.8-Max": {
          "name": "Qwen 3.8 Max"
        }
      }
    }
  },
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "question": "allow",
    "lsp": "allow",
    "skill": {
      "*": "allow"
    }
  },
  "experimental": {
    "primary_tools": []
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "context7-mcp"
      ],
      "enabled": true,
      "timeout": 8000
    },
    "playwright": {
      "type": "local",
      "command": [
        "playwright-mcp"
      ],
      "enabled": true,
      "timeout": 10000
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
      "timeout": 8000
    },
    "github": {
      "type": "local",
      "command": [
        "github-mcp-server",
        "stdio"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      },
      "enabled": true,
      "timeout": 10000
    },
    "codebase-memory": {
      "type": "local",
      "command": [
        "codebase-memory-mcp"
      ],
      "enabled": true,
      "timeout": 15000
    },
    "kubernetes": {
      "type": "local",
      "command": [
        "kubernetes-mcp-server",
        "--read-only"
      ],
      "enabled": true,
      "timeout": 15000
    },
    // terraform-mcp-server (HashiCorp Terraform) — enabled; uses ~/.terraform.d/credentials for auth.
    // Install: mise install (go:github.com/hashicorp/terraform-mcp-server/cmd/terraform-mcp-server in mise config)
    "terraform": {
      "type": "local",
      "command": [
        "terraform-mcp-server"
      ],
      "enabled": true,
      "timeout": 10000
    }
  }

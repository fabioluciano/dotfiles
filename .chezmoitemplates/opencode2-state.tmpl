{{- /* Reads ~/.config/opencode2/.active_provider and returns a JSON object with
     provider, profile and providerModels. Valid provider falls back to v1 state,
     then to default; profile stays as-is so callers can apply their own aliases. */ -}}
{{- $defaultProvider := get $.opencode "default_provider" | default "navy" -}}
{{- $stateFile := printf "%s/.config/opencode2/.active_provider" (env "HOME") -}}
{{- $v1StateFile := printf "%s/.config/opencode/.active_provider" (env "HOME") -}}
{{- $state := output "sh" "-c" (printf "cat %s 2>/dev/null || cat %s 2>/dev/null || { echo provider:%s; echo profile:optimized; }" $stateFile $v1StateFile $defaultProvider) | trim -}}
{{- $provider := $defaultProvider -}}
{{- $profile := "optimized" -}}
{{- if hasPrefix "provider:" $state -}}
{{- range $line := splitList "\n" $state }}
{{- $parts := splitList ":" $line -}}
{{- if eq (first $parts) "provider" }}{{- $provider = last $parts -}}{{- end -}}
{{- if eq (first $parts) "profile" }}{{- $profile = last $parts -}}{{- end -}}
{{- end -}}
{{- else -}}
{{- $provider = $state -}}
{{- $profile = "optimized" -}}
{{- end -}}
{{- if or (eq $profile "default") (eq $profile "moderate") -}}{{- $profile = "optimized" -}}{{- end -}}
{{- $validProviders := keys $.providers -}}
{{- if not (has $provider $validProviders) -}}{{- $provider = $defaultProvider -}}{{- end -}}
{{- $profileKey := printf "%s-%s" $provider $profile -}}
{{- $providerModels := index $.opencode.models $profileKey | default (index $.opencode.models $provider) -}}
{{- dict "provider" $provider "profile" $profile "providerModels" $providerModels | toJson -}}
